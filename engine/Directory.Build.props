<Project>
  <!-- The rule engine is a VSA app. It builds against the framework source in this repository (VSA.Sdk source mode).
       This repository has one global.json, so this folder sets the app root of the engine projects. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <VsaFrameworkSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'framework'))</VsaFrameworkSourceDir>
    <VsaAppRoot>$(MSBuildThisFileDirectory)</VsaAppRoot>
  </PropertyGroup>
  <!-- The step commands carry the definition. Only the Infrastructure layer gets the checker library (ArchUnitNET):
       it is the adapter, and EngineDefinition allows no other layer to use it. -->
  <ItemGroup>
    <VsaAppReference Include="VSA.Architecture" Layer="Contracts/Commands" Path="Architecture/Definition" />
    <VsaAppReference Include="VSA.Architecture" Layer="Handlers/Commands" Path="Architecture/Definition" />
    <VsaAppReference Include="VSA.Architecture.Engine" Layer="Infrastructure" Path="Architecture/Engine" />
  </ItemGroup>
</Project>
