<Project>
  <!-- The rule engine is a VSA app. It builds against the framework source in this repository (source mode).
       This repository has one global.json, so this folder sets the block folder of the engine projects. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UmpireFrameworkSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</UmpireFrameworkSourceDir>
    <UmpireBlock>$(MSBuildThisFileDirectory)</UmpireBlock>
    <ArtifactsPath>$(UmpireBlock)artifacts~</ArtifactsPath>
  </PropertyGroup>
  <Import Project="$(UmpireFrameworkSourceDir)tools/bundle/SourceMode/Umpire.SourceMode.props" />
</Project>
