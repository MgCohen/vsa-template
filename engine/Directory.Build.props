<Project>
  <!-- The rule engine is a VSA app. It builds against the framework source in this repository (Umpire.Sdk source mode).
       This repository has one global.json, so this folder sets the app root of the engine projects. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UmpireFrameworkSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</UmpireFrameworkSourceDir>
    <UmpireAppRoot>$(MSBuildThisFileDirectory)</UmpireAppRoot>
  </PropertyGroup>
</Project>
