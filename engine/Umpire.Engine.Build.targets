<Project>
  <!-- Runs the rule engine after each build of the project that has this package (the host of the app).
       UmpireCheck=false turns it off. UmpireCheckMode=Warn reports each error as a warning.
       The engine finds the block folder of the project. UmpireBlock sets it (this repository has one global.json for many apps).
       The stamp file skips the check when no input changed. -->
  <PropertyGroup>
    <UmpireCheck Condition="'$(UmpireCheck)' == ''">true</UmpireCheck>
    <UmpireCheckMode Condition="'$(UmpireCheckMode)' == ''">Error</UmpireCheckMode>
    <_UmpireEngine>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'tools', 'net10.0', 'umpire-engine.dll'))</_UmpireEngine>
    <_UmpireDotnet Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_UmpireDotnet>
    <_UmpireDotnet Condition="'$(_UmpireDotnet)' == ''">dotnet</_UmpireDotnet>
  </PropertyGroup>

  <Target Name="_UmpireCheckInputs">
    <PropertyGroup>
      <_UmpireBlockArgument Condition="'$(UmpireBlock)' != ''"> --block &quot;$(UmpireBlock.TrimEnd('\').TrimEnd('/'))&quot;</_UmpireBlockArgument>
      <_UmpireCheckStamp>$([MSBuild]::NormalizePath('$(ProjectDir)', '$(IntermediateOutputPath)', 'umpire-check.$(UmpireCheckMode).stamp'))</_UmpireCheckStamp>
    </PropertyGroup>
    <ItemGroup>
      <_UmpireCheckInput Include="@(IntermediateAssembly->'%(FullPath)');@(ReferenceCopyLocalPaths->'%(FullPath)');$(_UmpireEngine)" />
    </ItemGroup>
  </Target>

  <Target Name="UmpireCheck" AfterTargets="Build" DependsOnTargets="_UmpireCheckInputs"
          Condition="'$(UmpireCheck)' == 'true' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(_UmpireCheckInput)" Outputs="$(_UmpireCheckStamp)">
    <Error Condition="!Exists('$(_UmpireEngine)')" Code="UMP030003"
           Text="The rule engine $(_UmpireEngine) does not exist. Restore the Umpire.Engine.Build package again." />
    <Exec IgnoreExitCode="true" StandardOutputImportance="high" StandardErrorImportance="high"
          Command="&quot;$(_UmpireDotnet)&quot; exec &quot;$(_UmpireEngine)&quot; --project &quot;$(MSBuildProjectDirectory.TrimEnd('\').TrimEnd('/'))&quot;$(_UmpireBlockArgument) --bin &quot;$(TargetDir.TrimEnd('\').TrimEnd('/'))&quot; --mode $(UmpireCheckMode)">
      <Output TaskParameter="ExitCode" PropertyName="_UmpireCheckExit" />
    </Exec>
    <Touch Condition="'$(_UmpireCheckExit)' == '0'" Files="$(_UmpireCheckStamp)" AlwaysCreate="true" />
  </Target>
</Project>
