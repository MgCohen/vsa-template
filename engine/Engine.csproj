<Project Sdk="Microsoft.NET.Sdk">
  <!-- The rule engine: EngineApp<THost>, the jobs, the operations and the plugins, as one netstandard2.0 library (decision P2).
       It does no console work: each entry closes the host and converts the report. The console entry is Entries/Console/.
       It is not a package: the package Umpire.Engine holds the console entry in tools/net8.0/ (tools/bundle/Engine/Umpire.Engine.csproj). -->
  <PropertyGroup>
    <AssemblyName>Umpire.Engine</AssemblyName>
    <RootNamespace>UmpireEngine</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umpire.Vsa" Version="$(UmpireVersion)" />
    <ProjectReference Include="$(UmpireFrameworkSourceDir)engine/Versions/Umpire.Engine.Versions.csproj" />
  </ItemGroup>
  <!-- The engine of the package Umpire.Engine builds on the bundles (_UmpireUseBundle, Umpire.Engine.csproj): it loads the
       definition of an app, so its Architecture type must come from the same Umpire.Definition.dll as the app. -->
  <ItemGroup Condition="'$(_UmpireUseBundle)' != 'true'">
    <ProjectReference Include="$(UmpireFrameworkSourceDir)architecture/Umpire.Architecture.csproj" />
    <ProjectReference Include="$(UmpireFrameworkSourceDir)packs/Vsa/Definition/Umpire.Vsa.csproj" />
    <ProjectReference Include="$(UmpireFrameworkSourceDir)framework/Components/Config/Umpire.Config.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(_UmpireUseBundle)' == 'true'">
    <ProjectReference Include="$(UmpireFrameworkSourceDir)tools/bundle/Definition/Umpire.Definition.csproj" />
    <ProjectReference Include="$(UmpireFrameworkSourceDir)tools/bundle/VsaDefinition/Umpire.Vsa.Definition.csproj" />
  </ItemGroup>
  <!-- The polyfills of the netstandard2.0 build: extension methods with the names of the newer .NET APIs. Their folder name
       ends with ~, so the engine does not check it as a source folder. -->
  <ItemGroup>
    <Using Include="Umpire.Engine.Polyfills" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="TngTech.ArchUnitNET" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="umpire-engine" />
    <InternalsVisibleTo Include="Architecture.Tests" />
    <InternalsVisibleTo Include="Engine.Tests" />
  </ItemGroup>
</Project>
