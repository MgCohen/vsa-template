<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Umpire.Sdk.Dev.props'))" />
  <!-- The root project of the rule engine app. It compiles the app, its modules and its plugins.
       It is not a package: Umpire.Sdk and Umpire.Sdk.Web hold the engine in tools/net8.0/ (Umpire.Sdk.Package.targets). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>umpire-engine</AssemblyName>
    <RootNamespace>UmpireEngine</RootNamespace>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <!-- No ASP.NET Core framework reference: the .NET of a Unity Editor can have only Microsoft.NETCore.App. AppLoader loads
       the ASP.NET Core types of a web app definition from the shared folder of the runtime (SharedFrameworks). -->
  <ItemGroup>
    <ProjectReference Include="$(UmpireFrameworkSourceDir)engine/Versions/Umpire.Engine.Versions.csproj" />
  </ItemGroup>
  <!-- The engine of the SDK package builds on the bundles (_UmpireUseBundle, Umpire.Sdk.Package.targets): it loads the
       definition of an app, so its Architecture type must come from the same Umpire.dll as the app. -->
  <ItemGroup Condition="'$(_UmpireUseBundle)' != 'true'">
    <ProjectReference Include="$(UmpireFrameworkSourceDir)architecture/Umpire.Architecture.csproj" />
    <ProjectReference Include="$(UmpireFrameworkSourceDir)packs/Vsa/Architecture/Umpire.Vsa.csproj" />
    <ProjectReference Include="$(UmpireFrameworkSourceDir)framework/Kernel/Hosts/Console/Umpire.Hosts.Console.csproj" />
    <ProjectReference Include="$(UmpireFrameworkSourceDir)framework/Components/Config/Umpire.Config.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(_UmpireUseBundle)' == 'true'">
    <ProjectReference Include="$(UmpireFrameworkSourceDir)tools/bundle/Console/Umpire.Console.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
    <PackageReference Include="TngTech.ArchUnitNET" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Architecture.Tests" />
    <InternalsVisibleTo Include="Engine.Tests" />
  </ItemGroup>
  <Import Project="$(UmpireSdkDir)Sdk.targets" />
</Project>
