<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Umpire.Sdk.Dev.props'))" />
  <!-- The root project of the rule engine app. It compiles the app, its modules and its plugins.
       Its package is the build hook Umpire.Engine.Build: the engine in tools/, and the target that runs it after the build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>umpire-engine</AssemblyName>
    <RootNamespace>UmpireEngine</RootNamespace>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Umpire.Engine.Build</PackageId>
    <Description>Checks the architecture of an Umpire app after each build of its root project.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- A web app definition can need ASP.NET Core types when the engine makes its app class. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(UmpireFrameworkSourceDir)architecture/Umpire.Architecture.csproj" />
    <ProjectReference Include="$(UmpireFrameworkSourceDir)packs/Vsa/Architecture/Umpire.Vsa.csproj" />
    <ProjectReference Include="$(UmpireFrameworkSourceDir)framework/Kernel/Hosts/Console/Umpire.Hosts.Console.csproj" />
    <ProjectReference Include="$(UmpireFrameworkSourceDir)engine/Versions/Umpire.Engine.Versions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
    <PackageReference Include="TngTech.ArchUnitNET" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Architecture.Tests" />
    <InternalsVisibleTo Include="Engine.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Umpire.Engine.Build.targets" Pack="true" PackagePath="build/" />
  </ItemGroup>
  <Target Name="_UmpireEngineFiles" BeforeTargets="_GetPackageFiles" DependsOnTargets="Build">
    <ItemGroup>
      <None Include="$(OutDir)**" Exclude="$(OutDir)**/*.pdb" Pack="true" PackagePath="tools/net10.0/" />
    </ItemGroup>
  </Target>
  <Import Project="$(UmpireSdkDir)Sdk.targets" />
</Project>
