<Project Sdk="Microsoft.NET.Sdk">
  <!-- The build hook package: the engine app in tools/, and the target that runs it after the build of the host. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>VSA.Architecture.Build</PackageId>
    <Description>Checks the architecture of a VSA app after each build of its host project.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="build/*.targets" Pack="true" PackagePath="build/" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only for restore. A solution builds a project that it does not list in Debug, so the reference sets the
         configuration of this build: then the reference and the pack target build the engine one time, not twice at once. -->
    <ProjectReference Include="../Engine.csproj" ReferenceOutputAssembly="false" Private="false"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <Target Name="_VsaEngineFiles" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../Engine.csproj" Targets="Build;GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_VsaEngineDll" />
    </MSBuild>
    <PropertyGroup>
      <_VsaEngineDir>@(_VsaEngineDll->'%(RootDir)%(Directory)')</_VsaEngineDir>
    </PropertyGroup>
    <Error Condition="!Exists('@(_VsaEngineDll)')" Text="The engine is not built: @(_VsaEngineDll) does not exist." />
    <ItemGroup>
      <None Include="$(_VsaEngineDir)**" Exclude="$(_VsaEngineDir)**/*.pdb" Pack="true" PackagePath="tools/net10.0/" />
    </ItemGroup>
  </Target>
</Project>
