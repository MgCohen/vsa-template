<Project>
  <!-- The samples build against the framework source in this repository (Umpire.Sdk source mode). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UmpireFrameworkSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</UmpireFrameworkSourceDir>  </PropertyGroup>
  <!-- This repository has one global.json and more than one app. Each folder here is one app, so it is the block folder of its projects.
       A consumer app has its own global.json, so it does not set UmpireBlock. -->
  <PropertyGroup>
    <_UmpireDevApp>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/'))/</_UmpireDevApp>
    <UmpireBlock>$(MSBuildThisFileDirectory)$(_UmpireDevApp.Substring(0, $(_UmpireDevApp.IndexOf('/'))))/</UmpireBlock>
    <ArtifactsPath>$(UmpireBlock)artifacts~</ArtifactsPath>
  </PropertyGroup>
</Project>
