<Project>
  <!-- Takes the place of Sdk="Umpire.Sdk" inside this repository, so the samples use the SDK files from source.
       A consumer project is only <Project Sdk="Umpire.Sdk" />. -->
  <PropertyGroup>
    <UmpireSdkDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'tools', 'sdk', 'Sdk'))</UmpireSdkDir>
  </PropertyGroup>
  <Import Project="$(UmpireSdkDir)Sdk.props" />
</Project>
