<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- The views are in App.Views, so the SDK does not find .razor files here. This adds blazor.web.js. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <!-- Not private: a test project that references the host must get every module layer,
         for WebApplicationFactory tests and module discovery. Only test projects reference the host. -->
    <ProjectReference Include="../Views/App.Views.csproj" />
    <ProjectReference Include="../../Modules/*/*.csproj" />
    <ProjectReference Include="$(VsaFrameworkSourceDir)Layers/Host/VSA.Host.csproj" />
    <!-- Design-time only: lets dotnet ef build the host to read the model. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
