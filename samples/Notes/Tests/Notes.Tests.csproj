<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- NUnit on Microsoft.Testing.Platform (global.json). -->
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Notes.csproj" />
    <ProjectReference Include="$(VsaFrameworkSourceDir)packs/Vsa/Tests/Unit/VSA.Testing.Unit.csproj" />
  </ItemGroup>
</Project>
