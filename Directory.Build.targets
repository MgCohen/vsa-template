<Project>
  <!-- The VSA analyzer rules about any code (the format) also check the framework and its tests.
       VsaFrameworkCode turns off the rules about module code, for example the layers. A VSA.Sdk project gets the analyzer from VSA.Sdk.
       VSA.Analyzers cannot check itself, and Rules.Tests references it as a library. -->
  <PropertyGroup Condition="'$(UsingVsaSdk)' != 'true'">
    <VsaFrameworkCode>true</VsaFrameworkCode>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsingVsaSdk)' != 'true'">
    <CompilerVisibleProperty Include="VsaFrameworkCode" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsingVsaSdk)' != 'true' and '$(MSBuildProjectName)' != 'VSA.Analyzers' and '$(MSBuildProjectName)' != 'Rules.Tests'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)framework/Analyzers/VSA.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <!-- Source mode: a test project with a ProjectReference to VSA.Testing.Architecture gets the generated ArchitectureTests class. -->
  <Import Project="$(MSBuildThisFileDirectory)framework/Testing/Architecture/build/VsaArchitectureTests.targets" />
</Project>
