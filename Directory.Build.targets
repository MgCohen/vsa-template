<Project>
  <!-- The Umpire rules about any code (the format) also check the framework and its tests. The analyzer is the analyzer entry of
       the engine. UmpireFrameworkCode turns off the rules about module code, for example the layers. A project with the Umpire build
       (UsingUmpireBuild) gets the analyzer from its Umpire package (source mode: Umpire.SourceMode.targets). The analyzer build and
       the bundles get no analyzer, because the analyzer builds on them. -->
  <PropertyGroup Condition="'$(UsingUmpireBuild)' != 'true'">
    <UmpireFrameworkCode>true</UmpireFrameworkCode>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsingUmpireBuild)' != 'true'">
    <CompilerVisibleProperty Include="UmpireFrameworkCode" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsingUmpireBuild)' != 'true' and '$(UmpireAnalyzerBuild)' != 'true' and '$(_UmpireUseBundle)' != 'true' and '$(UmpireNoAnalyzer)' != 'true' and '$(MSBuildIsRestoring)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)engine/Entries/Analyzer/Engine.Analyzer.csproj" OutputItemType="_UmpireEngineAnalyzer"
                      ReferenceOutputAssembly="false" PrivateAssets="all" AdditionalProperties="UmpireAnalyzerBuild=true" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)tools/bundle/SourceMode/Umpire.EngineAnalyzer.targets" Condition="'$(UsingUmpireBuild)' != 'true'" />

  <!-- The pack takes the documentation file from bin/. The file is not there, so the pack does not take it. -->
  <Target Name="_UmpireKeepDocumentationFileInObj" AfterTargets="DocumentationProjectOutputGroup"
          Condition="'$(CopyDocumentationFileToOutputDirectory)' == 'false'">
    <ItemGroup>
      <DocumentationProjectOutputGroupOutput Remove="@(DocumentationProjectOutputGroupOutput)" />
    </ItemGroup>
  </Target>
</Project>
