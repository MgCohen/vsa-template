<Project>
  <!-- The layers that Unity can use also target netstandard2.1 (see docs/unity.md). -->
  <PropertyGroup>
    <UmpirePortableLayer Condition="'$(MSBuildProjectName)' == 'Umpire.Vsa.Domain' or '$(MSBuildProjectName)' == 'Umpire.Messages.Handlers' or '$(MSBuildProjectName)' == 'Umpire.Messages.Contracts' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Contracts.Events' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Contracts.Commands' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Handlers.Commands' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Handlers.Events' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Infrastructure' or '$(MSBuildProjectName)' == 'Umpire.Kernel' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Composition' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Contracts.Requests' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Handlers.Requests' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Presenters' or '$(MSBuildProjectName)' == 'Umpire.Architecture' or '$(MSBuildProjectName)' == 'Umpire.Vsa'">true</UmpirePortableLayer>
  </PropertyGroup>

  <!-- All build output goes to artifacts~, so no bin/ or obj/ folder is next to the code. The library projects and the test
       projects share the artifacts~ folder of the repository root. Each block (engine, fixtures, templates) sets its own. -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts~</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework Condition="'$(UmpirePortableLayer)' != 'true'">net10.0</TargetFramework>
    <TargetFrameworks Condition="'$(UmpirePortableLayer)' == 'true'">net10.0;netstandard2.1</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- All Umpire packages ship together with one version. -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Authors>Umpire</Authors>
    <!-- GitHub Packages links each package to this repository. -->
    <RepositoryUrl>https://github.com/MgCohen/vsa-template</RepositoryUrl>
  </PropertyGroup>

  <!-- The framework and its tests follow the same editor rules and Umpire rule values as a consumer (Umpire.Rules.props). -->
  <Import Project="$(MSBuildThisFileDirectory)tools/sdk/Sdk/Umpire.Rules.props" />

  <!-- netstandard2.1 does not have some types that the compiler needs. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Include="$(MSBuildThisFileDirectory)tools/sdk/Polyfills/*.cs" />
  </ItemGroup>
</Project>
