<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <VsaSrcDir>$(MSBuildThisFileDirectory)src/</VsaSrcDir>
    <VsaFrameworkDir>$(VsaSrcDir)Framework/</VsaFrameworkDir>
    <VsaModulesDir>$(VsaSrcDir)Modules/</VsaModulesDir>
  </PropertyGroup>
</Project>
