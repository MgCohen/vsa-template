<Project>
  <!-- The layers that Unity can use also target netstandard2.1 (see docs/unity.md). -->
  <PropertyGroup>
    <UmpirePortableLayer Condition="'$(MSBuildProjectName)' == 'Umpire.Vsa.Domain' or '$(MSBuildProjectName)' == 'Umpire.Messages.Handlers' or '$(MSBuildProjectName)' == 'Umpire.Messages.Contracts' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Contracts.Events' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Contracts.Commands' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Handlers.Commands' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Handlers.Events' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Infrastructure' or '$(MSBuildProjectName)' == 'Umpire.Kernels' or '$(MSBuildProjectName)' == 'Umpire.Kernels.Definition' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Composition' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Contracts.Requests' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Handlers.Requests' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Presenters' or '$(MSBuildProjectName)' == 'Umpire.Architecture' or '$(MSBuildProjectName)' == 'Umpire.Vsa' or '$(MSBuildProjectName)' == 'Umpire.Config' or '$(MSBuildProjectName)' == 'Umpire'">true</UmpirePortableLayer>
  </PropertyGroup>

  <!-- The runtime projects ship in the bundle packages of tools/bundle/ (Umpire, Umpire.Web, Umpire.Console, Umpire.Testing),
       so they are not packages. -->
  <PropertyGroup>
    <UmpireBundled Condition="$([System.String]::Copy(';Umpire.Markers;Umpire.Architecture;Umpire.Config;Umpire.Kernels;Umpire.Kernels.Definition;Umpire.Messages.Contracts;Umpire.Messages.Handlers;Umpire.Vsa;Umpire.Vsa.Composition;Umpire.Vsa.Domain;Umpire.Vsa.Infrastructure;Umpire.Vsa.Presenters;Umpire.Vsa.Contracts.Requests;Umpire.Vsa.Contracts.Events;Umpire.Vsa.Contracts.Commands;Umpire.Vsa.Handlers.Requests;Umpire.Vsa.Handlers.Events;Umpire.Vsa.Handlers.Commands;Umpire.Vsa.Views;Umpire.Hosts.Web;Umpire.Hosts.Console;Umpire.Vsa.Testing.Unit;').Contains(';$(MSBuildProjectName);'))">true</UmpireBundled>
    <IsPackable Condition="'$(UmpireBundled)' == 'true'">false</IsPackable>
  </PropertyGroup>

  <!-- All build output goes to artifacts~, so no bin/ or obj/ folder is next to the code. The library projects and the test
       projects share the artifacts~ folder of the repository root. Each block (engine, fixtures, templates) sets its own. -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts~</ArtifactsPath>
  </PropertyGroup>

  <!-- The rule engine and its own projects target net8.0, so the engine runs on the .NET 8 of a Unity 6000.6 Editor and,
       with RollForward Major, on each newer runtime. The portable libraries (Umpire.dll) have one build, netstandard2.1, for
       Unity, for .NET apps and for the engine. The engine loads the definition of an app, and a record of a net8.0 build and
       of a netstandard2.1 build have different methods, so one build keeps one shape (see docs/unity.md). -->
  <PropertyGroup>
    <UmpireEngineLayer Condition="'$(MSBuildProjectName)' == 'Engine' or '$(MSBuildProjectName)' == 'Engine.Definition' or '$(MSBuildProjectName)' == 'Umpire.Engine.Versions' or '$(MSBuildProjectName)' == 'Umpire.Hosts.Console' or '$(MSBuildProjectName)' == 'Umpire.Console'">true</UmpireEngineLayer>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework Condition="'$(UmpirePortableLayer)' != 'true' and '$(UmpireEngineLayer)' != 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(UmpireEngineLayer)' == 'true'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(UmpirePortableLayer)' == 'true'">netstandard2.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- The general build settings of each Umpire project: the same file as in Umpire.Sdk. -->
  <Import Project="$(MSBuildThisFileDirectory)tools/sdk/Sdk/Umpire.Common.props" />

  <!-- The findings of the architecture check are errors in this repository: the engine, the templates and the framework blocks.
       The default of an app is Warn. A new app does not get this file. -->
  <PropertyGroup>
    <UmpireCheckMode Condition="'$(UmpireCheckMode)' == ''">Error</UmpireCheckMode>
  </PropertyGroup>

  <!-- The Umpire analyzer findings are warnings by default. These codes are errors in this repository. An .editorconfig severity
       cannot do this, because WarningsNotAsErrors of the Umpire SDK (Umpire.Codes.props) wins over it. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);UMP010001;UMP010002;UMP010003;UMP010107;UMP010201</WarningsAsErrors>
  </PropertyGroup>

  <!-- All Umpire packages ship together with one version. -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Authors>Umpire</Authors>
    <!-- GitHub Packages links each package to this repository. -->
    <RepositoryUrl>https://github.com/MgCohen/vsa-template</RepositoryUrl>
  </PropertyGroup>

  <!-- The style switches of this repository. The rules are in the root .editorconfig. Umpire.Sdk ships no style, so a consumer
       app sets its own. -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild Condition="'$(EnforceCodeStyleInBuild)' == ''">true</EnforceCodeStyleInBuild>
    <!-- IDE0005 reports an unused using in the build only when the compiler reads the XML comments. -->
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">true</GenerateDocumentationFile>
    <!-- The compiler writes the file to obj/. UMP010106 permits no XML comments, so the file is not copied to bin/, publish or the package. -->
    <CopyDocumentationFileToOutputDirectory Condition="'$(CopyDocumentationFileToOutputDirectory)' == ''">false</CopyDocumentationFileToOutputDirectory>
    <PublishDocumentationFile Condition="'$(PublishDocumentationFile)' == ''">false</PublishDocumentationFile>
    <!-- CS1591: the documentation file is for the code style rules only. Public members do not need XML comments. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The formatting rules are warnings while the team examines them. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IDE0055;IDE0011;IDE2000;IDE0008;IDE0040;IDE2002;IDE0036;IDE0049;IDE0054;IDE1005;IDE0083;IDE0021;IDE0022;IDE0023;IDE0024;IDE0025;IDE0026;IDE0027;IDE0053;IDE0061;IDE1006;IDE0051;IDE0052;IDE0059;IDE0060;IDE0005;IDE0004;IDE0079;CA1052;CA1012;CA2000;CA1849;CA1812;UMP010101;UMP010102;UMP010103;UMP010104;UMP010105;UMP010106</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'"><NoWarn>$(NoWarn);CS0436</NoWarn></PropertyGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('netstandard'))">
    <Compile Include="$(MSBuildThisFileDirectory)tools/sdk/Polyfills~/IsExternalInit.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UmpirePortableLayer)' == 'true' or '$(MSBuildProjectName)' == 'Umpire'">
    <Compile Include="$(MSBuildThisFileDirectory)tools/sdk/Polyfills~/NetStandard20.cs" />
  </ItemGroup>
</Project>
