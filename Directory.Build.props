<Project>
  <!-- The layers that Unity can use also target netstandard2.1 (see docs/consumers.md). -->
  <PropertyGroup>
    <VsaPortableLayer Condition="'$(MSBuildProjectName)' == 'VSA.Domain' or '$(MSBuildProjectName)' == 'VSA.Handlers' or '$(MSBuildProjectName)' == 'VSA.Contracts' or '$(MSBuildProjectName)' == 'VSA.Contracts.Events' or '$(MSBuildProjectName)' == 'VSA.Contracts.Commands' or '$(MSBuildProjectName)' == 'VSA.Handlers.Commands' or '$(MSBuildProjectName)' == 'VSA.Handlers.Events' or '$(MSBuildProjectName)' == 'VSA.Infrastructure' or '$(MSBuildProjectName)' == 'VSA.Module' or '$(MSBuildProjectName)' == 'VSA.Kernel' or '$(MSBuildProjectName)' == 'VSA.Composition' or '$(MSBuildProjectName)' == 'VSA.Contracts.Requests' or '$(MSBuildProjectName)' == 'VSA.Handlers.Requests' or '$(MSBuildProjectName)' == 'VSA.Presenters' or '$(MSBuildProjectName)' == 'VSA.Architecture' or '$(MSBuildProjectName)' == 'VSA.Architecture.Vsa'">true</VsaPortableLayer>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework Condition="'$(VsaPortableLayer)' != 'true'">net10.0</TargetFramework>
    <TargetFrameworks Condition="'$(VsaPortableLayer)' == 'true'">net10.0;netstandard2.1</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- All VSA packages ship together with one version. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>VSA</Authors>
    <!-- GitHub Packages links each package to this repository. -->
    <RepositoryUrl>https://github.com/MgCohen/vsa-template</RepositoryUrl>
  </PropertyGroup>

  <!-- The framework and its tests follow the same editor rules and VSA rule values as a consumer (VSA.Rules.props). -->
  <Import Project="$(MSBuildThisFileDirectory)framework/Sdk/Sdk/VSA.Rules.props" />

  <!-- netstandard2.1 does not have some types that the compiler needs. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Include="$(MSBuildThisFileDirectory)framework/Polyfills/*.cs" />
  </ItemGroup>
</Project>
