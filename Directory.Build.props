<Project>
  <!-- The layers that Unity can use also target netstandard2.1 (see docs/unity.md). -->
  <PropertyGroup>
    <UmpirePortableLayer Condition="'$(MSBuildProjectName)' == 'Umpire.Vsa.Domain' or '$(MSBuildProjectName)' == 'Umpire.Messages.Handlers' or '$(MSBuildProjectName)' == 'Umpire.Messages.Contracts' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Contracts.Events' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Contracts.Commands' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Handlers.Commands' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Handlers.Events' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Infrastructure' or '$(MSBuildProjectName)' == 'Umpire.Kernels' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Composition' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Contracts.Requests' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Handlers.Requests' or '$(MSBuildProjectName)' == 'Umpire.Vsa.Presenters' or '$(MSBuildProjectName)' == 'Umpire.Architecture' or '$(MSBuildProjectName)' == 'Umpire.Vsa' or '$(MSBuildProjectName)' == 'Umpire.Config' or '$(MSBuildProjectName)' == 'Umpire'">true</UmpirePortableLayer>
  </PropertyGroup>

  <!-- The runtime projects ship in the bundle packages of tools/bundle/ (Umpire, Umpire.Web, Umpire.Console, Umpire.Testing),
       so they are not packages. -->
  <PropertyGroup>
    <UmpireBundled Condition="$([System.String]::Copy(';Umpire.Markers;Umpire.Architecture;Umpire.Config;Umpire.Kernels;Umpire.Messages.Contracts;Umpire.Messages.Handlers;Umpire.Vsa;Umpire.Vsa.Composition;Umpire.Vsa.Domain;Umpire.Vsa.Infrastructure;Umpire.Vsa.Presenters;Umpire.Vsa.Contracts.Requests;Umpire.Vsa.Contracts.Events;Umpire.Vsa.Contracts.Commands;Umpire.Vsa.Handlers.Requests;Umpire.Vsa.Handlers.Events;Umpire.Vsa.Handlers.Commands;Umpire.Vsa.Views;Umpire.Hosts.Web;Umpire.Hosts.Console;Umpire.Vsa.Testing.Unit;').Contains(';$(MSBuildProjectName);'))">true</UmpireBundled>
    <IsPackable Condition="'$(UmpireBundled)' == 'true'">false</IsPackable>
  </PropertyGroup>

  <!-- All build output goes to artifacts~, so no bin/ or obj/ folder is next to the code. The library projects and the test
       projects share the artifacts~ folder of the repository root. Each block (engine, fixtures, templates) sets its own. -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts~</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework Condition="'$(UmpirePortableLayer)' != 'true'">net10.0</TargetFramework>
    <TargetFrameworks Condition="'$(UmpirePortableLayer)' == 'true'">net10.0;netstandard2.1</TargetFrameworks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- The general build settings of each Umpire project: the same file as in Umpire.Sdk. -->
  <Import Project="$(MSBuildThisFileDirectory)tools/sdk/Sdk/Umpire.Common.props" />

  <!-- All Umpire packages ship together with one version. -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Authors>Umpire</Authors>
    <!-- GitHub Packages links each package to this repository. -->
    <RepositoryUrl>https://github.com/MgCohen/vsa-template</RepositoryUrl>
  </PropertyGroup>

  <!-- The style switches of this repository. The rules are in the root .editorconfig. Umpire.Sdk ships no style, so a consumer
       app sets its own. -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild Condition="'$(EnforceCodeStyleInBuild)' == ''">true</EnforceCodeStyleInBuild>
    <!-- IDE0005 reports an unused using in the build only when the compiler reads the XML comments. -->
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">true</GenerateDocumentationFile>
    <!-- The compiler writes the file to obj/. UMP010106 permits no XML comments, so the file is not copied to bin/, publish or the package. -->
    <CopyDocumentationFileToOutputDirectory Condition="'$(CopyDocumentationFileToOutputDirectory)' == ''">false</CopyDocumentationFileToOutputDirectory>
    <PublishDocumentationFile Condition="'$(PublishDocumentationFile)' == ''">false</PublishDocumentationFile>
    <!-- CS1591: the documentation file is for the code style rules only. Public members do not need XML comments. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The formatting rules are warnings while the team examines them. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IDE0055;IDE0011;IDE2000;IDE0008;IDE0040;IDE2002;IDE0036;IDE0049;IDE0054;IDE1005;IDE0083;IDE0021;IDE0022;IDE0023;IDE0024;IDE0025;IDE0026;IDE0027;IDE0053;IDE0061;IDE1006;IDE0051;IDE0052;IDE0059;IDE0060;IDE0005;IDE0004;IDE0079;CA1052;CA1012;CA2000;CA1849;CA1812;UMP010101;UMP010102;UMP010103;UMP010104;UMP010105;UMP010106</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- netstandard2.1 does not have some types that the compiler needs. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Include="$(MSBuildThisFileDirectory)tools/sdk/Polyfills/*.cs" />
  </ItemGroup>
</Project>
