<Project>
  <!-- The layers that Unity can use also target netstandard2.1 (see docs/consumers.md). -->
  <PropertyGroup>
    <VsaUnityLayer Condition="'$(MSBuildProjectName)' == 'VSA.Domain' or '$(MSBuildProjectName)' == 'VSA.Contracts.Events' or '$(MSBuildProjectName)' == 'VSA.Handlers.Events' or '$(MSBuildProjectName)' == 'VSA.Infrastructure' or '$(MSBuildProjectName)' == 'VSA.Module'">true</VsaUnityLayer>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework Condition="'$(VsaUnityLayer)' != 'true'">net10.0</TargetFramework>
    <TargetFrameworks Condition="'$(VsaUnityLayer)' == 'true'">net10.0;netstandard2.1</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- All VSA packages ship together with one version. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>VSA</Authors>
    <!-- GitHub Packages links each package to this repository. -->
    <RepositoryUrl>https://github.com/MgCohen/vsa-template</RepositoryUrl>
  </PropertyGroup>

  <!-- netstandard2.1 does not have some types that the compiler needs. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Include="$(MSBuildThisFileDirectory)framework/Layers/Polyfills/*.cs" />
  </ItemGroup>
</Project>
