<Project Sdk="Microsoft.NET.Sdk">
  <!-- The VSA architecture definition: the VSA layers and rules, and the VSA pack Vsa<THost>, which joins the definition
       and a VSA host. It depends on each layer base of the VSA kernel, so an app gets all of them from this one package.
       It has no test framework, no ArchUnitNET and no Mono.Cecil. -->
  <ItemGroup>
    <Compile Include="../VsaPack.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../architecture/Umpire.Architecture.csproj" />
    <ProjectReference Include="../Kernel/Composition/Umpire.Vsa.Composition.csproj" />
    <ProjectReference Include="../Kernel/Domain/Umpire.Vsa.Domain.csproj" />
    <ProjectReference Include="../Kernel/Infrastructure/Umpire.Vsa.Infrastructure.csproj" />
    <ProjectReference Include="../Kernel/Presenters/Umpire.Vsa.Presenters.csproj" />
    <ProjectReference Include="../Kernel/Contracts/Requests/Umpire.Vsa.Contracts.Requests.csproj" />
    <ProjectReference Include="../Kernel/Contracts/Events/Umpire.Vsa.Contracts.Events.csproj" />
    <ProjectReference Include="../Kernel/Contracts/Commands/Umpire.Vsa.Contracts.Commands.csproj" />
    <ProjectReference Include="../Kernel/Handlers/Requests/Umpire.Vsa.Handlers.Requests.csproj" />
    <ProjectReference Include="../Kernel/Handlers/Events/Umpire.Vsa.Handlers.Events.csproj" />
    <ProjectReference Include="../Kernel/Handlers/Commands/Umpire.Vsa.Handlers.Commands.csproj" />
  </ItemGroup>
  <!-- The package depends on the VSA analyzers and their rule values, so each app that references it gets them. The analyzers
       run only in a compilation that selects the VSA pack (RuleAnalyzer.PackAssembly). The reference is only for the pack:
       a build does not copy the analyzer DLL, and source mode adds the analyzers in Umpire.Sdk.Core.targets. -->
  <ItemGroup Condition="'$(_IsPacking)' == 'true'">
    <ProjectReference Include="../Tests/Analyzers/Umpire.Vsa.Analyzers.csproj" Private="false" PrivateAssets="none" />
  </ItemGroup>
  <!-- NuGet takes the dependencies from the restore. A restore with no _IsPacking (dotnet pack with its no-restore switch)
       has no analyzer reference, so the package would have no analyzers. -->
  <Target Name="_UmpireCheckAnalyzerDependency" BeforeTargets="GenerateNuspec">
    <Error Condition="!$([System.IO.File]::ReadAllText('$(ProjectAssetsFile)').Contains('Umpire.Vsa.Analyzers'))"
           Text="The restore of Umpire.Vsa has no reference to Umpire.Vsa.Analyzers, so the package would have no analyzers. Run dotnet pack with its own restore, or restore with -p:_IsPacking=true first." />
  </Target>
</Project>
