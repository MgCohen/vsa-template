<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('VSA.Sdk.Dev.props'))" />
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.StaticWebAssets" />
  <PropertyGroup>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <ElkScripts>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), '..', 'Infrastructure', 'wwwroot'))</ElkScripts>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Content Include="$(ElkScripts)**" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" ContentRoot="$(ElkScripts)" />
  </ItemGroup>
  <Import Project="$(VsaSdkDir)Sdk.targets" />
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.StaticWebAssets" />
</Project>
