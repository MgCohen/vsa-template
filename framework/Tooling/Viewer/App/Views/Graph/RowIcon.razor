<g transform="@Svg.Format($"translate({X},{Y})")" fill="none" stroke="@Color" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
    @switch (Role)
    {
        case "handler":
            <circle cx="6" cy="6" r="5" />
            <circle cx="6" cy="6" r="1.6" fill="@Color" />
            break;
        case "request":
            <path d="M1 6H10M7 3L10 6L7 9" />
            break;
        case "response":
            <path d="M11 6H2M5 3L2 6L5 9" />
            break;
        case "event":
            <path d="M7 1L2.5 7H6L5 11L9.5 5H6Z" />
            break;
        case "store":
            <ellipse cx="6" cy="3" rx="4.5" ry="2" />
            <path d="M1.5 3V9C1.5 10.1 3.5 11 6 11S10.5 10.1 10.5 9V3" />
            break;
        case "module":
            <rect x="1" y="1" width="10" height="10" rx="2" />
            <rect x="4" y="4" width="4" height="4" fill="@Color" stroke="none" />
            break;
        case "view":
            <rect x="1" y="1.5" width="10" height="9" rx="1.5" />
            <path d="M1 4.5H11" />
            break;
        case "more":
            <path d="M6 2V10M2 6H10" />
            break;
        default:
            <rect x="1.5" y="1" width="9" height="10" rx="1.5" />
            <path d="M4 4.5H8M4 7.5H8" />
            break;
    }
</g>

@code {
    [Parameter, EditorRequired] public string Role { get; set; } = "";
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public string Color { get; set; } = "#3b4357";
}
