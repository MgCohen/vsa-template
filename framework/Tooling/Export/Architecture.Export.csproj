<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes architecture.json of an app with the architecture engine (docs/architecture-data.md).
       It does not ship yet: a later `vsa export` command replaces it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- A VSA app can use ASP.NET Core, so the export loads its assemblies with that shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../Architecture/Engine/VSA.Architecture.Engine.csproj" />
  </ItemGroup>
</Project>
