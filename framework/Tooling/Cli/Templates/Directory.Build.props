<Project>
  <!-- The templates build against the framework source, as the samples do. The tool does not copy this file. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../../samples/Directory.Build.props" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The templates are one app. The tool writes a global.json in the root of a new app, so a new app does not set this. -->
    <VsaAppRoot>$(MSBuildThisFileDirectory)</VsaAppRoot>
  </PropertyGroup>
</Project>
