<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- The package holds the DLL as an analyzer, not as a library. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unity 6 runs Roslyn 4.10, and an analyzer that references a newer compiler does not run there (CS9057). A newer compiler runs it. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.10.0" PrivateAssets="all" />
    <Compile Remove="Markers/**" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md;AnalyzerReleases.Unshipped.md" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <ProjectReference Include="../Kernel/Analyzers/VSA.Kernel.Analyzers.csproj" PrivateAssets="all" />
  </ItemGroup>
  <!-- The package also holds the kernel analyzer DLL, because the VSA rules inherit its base classes. -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_VsaKernelAnalyzerInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="_VsaKernelAnalyzerInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'VSA.Kernel.Analyzers'" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
