<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../Contracts/Requests/VSA.Contracts.Requests.csproj" />
    <!-- A presenter gets the events of the modules (IPresenterEvent). It does not publish them (VSA1004). -->
    <ProjectReference Include="../Contracts/Events/VSA.Contracts.Events.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <!-- The installer of the layer uses VSA.Module. Private, so the module projects of this layer do not see VSA.Module. -->
  <ItemGroup>
    <ProjectReference Include="../Module/VSA.Module.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
