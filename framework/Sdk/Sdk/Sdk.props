<Project>
  <!-- VSA.Sdk: the .NET SDK plus the VSA layer rules. A module project is one line: <Project Sdk="VSA.Sdk" />. -->

  <!-- Modules/<Module>/Projects/ and Plugins/<Module>/Projects/ hold the layer projects of a slice module. Projects in one folder cannot share obj/,
       so each project gets its own build folders. Unity does not import folders whose names end in "~".
       These properties must be set before the .NET SDK reads them. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').EndsWith('/Projects')) and ($(MSBuildProjectDirectory.Replace('\', '/').Contains('/Modules/')) or $(MSBuildProjectDirectory.Replace('\', '/').Contains('/Plugins/')))">
    <VsaProjectsFolder>true</VsaProjectsFolder>
    <BaseIntermediateOutputPath>obj~/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin~/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(MSBuildThisFileDirectory)VSA.Version.props" Condition="Exists('$(MSBuildThisFileDirectory)VSA.Version.props')" />

  <PropertyGroup>
    <UsingVsaSdk>true</UsingVsaSdk>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The built-in .NET analyzers and code style rules. The custom VSA rules come from VSA.Analyzers. -->
  <PropertyGroup>
    <AnalysisLevel Condition="'$(AnalysisLevel)' == ''">latest-recommended</AnalysisLevel>
  </PropertyGroup>
  <!-- In the VSA repository, the root Directory.Build.props imports the rules first. -->
  <Import Project="$(MSBuildThisFileDirectory)VSA.Rules.props" Condition="'$(_VsaRulesImported)' != 'true'" />
</Project>
