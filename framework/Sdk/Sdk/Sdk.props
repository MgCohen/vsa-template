<Project>
  <!-- VSA.Sdk: the .NET SDK, the VSA framework packages, the analyzers and the rule values. A project is one line: <Project Sdk="VSA.Sdk" />. -->

  <!-- A web app uses <Project Sdk="Microsoft.NET.Sdk.Web"> with <Sdk Name="VSA.Sdk" />. That SDK imports the .NET SDK, so VSA.Sdk does not. -->
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' != 'true'">
    <_VsaImportsNetSdk>true</_VsaImportsNetSdk>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" Condition="'$(_VsaImportsNetSdk)' == 'true'" />
  <Import Project="$(MSBuildThisFileDirectory)VSA.Version.props" Condition="Exists('$(MSBuildThisFileDirectory)VSA.Version.props')" />

  <PropertyGroup>
    <UsingVsaSdk>true</UsingVsaSdk>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The built-in .NET analyzers and code style rules. The custom VSA rules come from VSA.Analyzers. -->
  <PropertyGroup>
    <AnalysisLevel Condition="'$(AnalysisLevel)' == ''">latest-recommended</AnalysisLevel>
  </PropertyGroup>
  <!-- In the VSA repository, the root Directory.Build.props imports the rules first. -->
  <Import Project="$(MSBuildThisFileDirectory)VSA.Rules.props" Condition="'$(_VsaRulesImported)' != 'true'" />
</Project>
