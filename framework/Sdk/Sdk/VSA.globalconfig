# The analyzer settings of every VSA.Sdk project. A consumer can change a rule in its own .editorconfig.
# The built-in rules come from AnalysisLevel = latest-recommended in Sdk.props.
# Set a severity with the standard key, for example: dotnet_diagnostic.CA1822.severity = none
is_global = true
global_level = -1

# Options of the custom VSA analyzers: vsa.<key> for all rules, vsa.<rule ID>.<key> for one rule.
vsa.VSA1001.check_responses = true
# The bases that a Domain.Shared type can use, apart from the Domain.Shared projects. Write a comma between the items.
vsa.VSA1006.allowed_bases = System.IEquatable`1, System.IComparable`1

# CA1716 does not check namespaces: the published domain of a module is <Module>.Domain.Shared, and "Shared" is a VB keyword.
dotnet_code_quality.CA1716.analyzed_symbol_kinds = NamedType, Method, Property, Event, Parameter
