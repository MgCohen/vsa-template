<Project>
  <!--
    The layer rules: the project references that each layer gets. The architecture tests check the uses of each type
    with the VSA definition (framework/Architecture/Vsa/VsaDefinition.cs). Keep the two the same.
    The app root is the folder of global.json, the same rule as the vsa tool. An app can set VsaAppRoot itself.
    A project with rules is in a root folder of the app: <root>/<RootFolder>/<Name>/. VsaRootFolders lists them.
    A module (Features/) has this slice layout:

      Features/Notes/Notes.csproj                             the module root: the *.cs files of Features/Notes/
      Features/Notes/Projects/Notes.Domain.Shared.csproj      Domain/Shared/** (the published domain)
      Features/Notes/Projects/Notes.Domain.csproj             Domain/** except Domain/Shared/**
      Features/Notes/Projects/Notes.Infrastructure.csproj     Infrastructure/**
      Features/Notes/Projects/Notes.Presenters.csproj         Presenters/**
      Features/Notes/Projects/Notes.Contracts.Requests.csproj the slice files with requests, responses and their DTOs
      Features/Notes/Projects/Notes.Contracts.Events.csproj   the slice files with events and their DTOs
      Features/Notes/Projects/Notes.Contracts.Commands.csproj the slice files with commands and their results
      Features/Notes/Projects/Notes.Handlers.Requests.csproj  the other files of the slices with a request handler
      Features/Notes/Projects/Notes.Handlers.Events.csproj    the other files of the slices with an event handler
      Features/Notes/Projects/Notes.Handlers.Commands.csproj  the other files of the slices with a command handler

    A plugin module (Plugins/) has the layout of the framework: no Slices/, one folder for each layer.
    Plugins/Pipeline/Handlers/Commands/** goes to Plugins/Pipeline/Projects/Pipeline.Handlers.Commands.csproj,
    and the same for each other layer.

    VsaRootFolder is the root folder (Features or Plugins), and VsaModule is the folder after it.
    The layer of a project in Projects/ comes from its name.
    The VsaRouteSliceFiles task (framework/Sdk/Tasks) selects the project of each file in Slices/ of a module by its types.
    A project that is not in a root folder gets no rules.
    A plugin module is the base of the same layer in each module, as the framework is.
    "Private" references use PrivateAssets="all". The framework base of each layer is exposed.

    Two modes for the framework references:
      Package mode (consumers): PackageReference to VSA.* with the version of this SDK.
      Source mode (this repository): ProjectReference into framework/, when VsaFrameworkSourceDir is set.

    Checks:
      VSA0001  a reference written by hand (_VsaCheck)
      VSA0002  VsaPluginUses out of a plugin layer, or a bad name in it (_VsaCheckUses)
      VSA0003  a project in a Features or Plugins folder that is not a root folder of the app root (_VsaCheckRoot)
      VSA0004  a project in the wrong folder, or a project in Projects/ with a name that is not <Module>.<Layer> (_VsaCheck)
      VSA0005  a routing error, from the VsaRouteSliceFiles task
      VSA0006  a Compile item written by hand, a .cs file that no project compiles, or Slices/ in a plugin module (_VsaCheck)
      VSA0007  a module project of a Unity app that does not target netstandard2.1 (_VsaCheck)
      VSA0008  the .NET test project of a Unity app finds more than one app folder, or a module source that uses UnityEngine (_VsaUnitySources)
    _VsaCheck uses lists made at evaluation, so the order of the requested targets does not change them.
  -->
  <PropertyGroup>
    <VsaAppRoot Condition="'$(VsaAppRoot)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'global.json'))</VsaAppRoot>
    <!-- The rules below know Features and Plugins. A new root folder in this list also needs its own rules. -->
    <VsaRootFolders Condition="'$(VsaRootFolders)' == ''">Features;Plugins</VsaRootFolders>
    <_VsaRoot Condition="'$(VsaAppRoot)' != ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(VsaAppRoot)').Replace('\', '/'))</_VsaRoot>
    <_VsaPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)').Replace('\', '/'))</_VsaPath>
    <_VsaCheckedPath>$(_VsaPath)</_VsaCheckedPath>
  </PropertyGroup>
  <!-- A Unity app (ProjectSettings/ProjectVersion.txt in the app root): Unity compiles Assets/, so the module projects
       are in a sibling folder of Assets/, VsaUnitySource. VsaDefinition.UnitySource has the same default. -->
  <PropertyGroup Condition="'$(_VsaRoot)' != '' and Exists('$(_VsaRoot)ProjectSettings/ProjectVersion.txt')">
    <VsaUnityProject>true</VsaUnityProject>
    <VsaUnitySource Condition="'$(VsaUnitySource)' == ''">Source</VsaUnitySource>
    <_VsaGroupRoot>$(_VsaRoot)$(VsaUnitySource)/</_VsaGroupRoot>
  </PropertyGroup>
  <PropertyGroup>
    <_VsaGroupRoot Condition="'$(_VsaGroupRoot)' == ''">$(_VsaRoot)</_VsaGroupRoot>
  </PropertyGroup>
  <!-- Not case-sensitive, for the drive letter and the folder names on Windows. -->
  <PropertyGroup Condition="'$(_VsaGroupRoot)' != '' and $(_VsaPath.ToLowerInvariant().StartsWith($(_VsaGroupRoot.ToLowerInvariant())))">
    <_VsaUnder>$(_VsaPath.Substring($(_VsaGroupRoot.Length)).TrimEnd('/'))</_VsaUnder>
    <_VsaFirst>$(_VsaUnder.IndexOf('/'))</_VsaFirst>
    <_VsaCheckedPath>/$(_VsaUnder)/</_VsaCheckedPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_VsaFirst)' != '' and '$(_VsaFirst)' != '-1'">
    <_VsaRootPart>$(_VsaUnder.Substring(0, $(_VsaFirst)))</_VsaRootPart>
    <VsaRootFolder Condition="$([System.String]::Copy(';$(VsaRootFolders);').Contains(';$(_VsaRootPart);'))">$(_VsaRootPart)</VsaRootFolder>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VsaRootFolder)' != ''">
    <VsaFeaturesDir>$(_VsaGroupRoot)Features/</VsaFeaturesDir>
    <VsaPluginsDir>$(_VsaGroupRoot)Plugins/</VsaPluginsDir>
    <_VsaRelative>$(_VsaUnder.Substring($([MSBuild]::Add($(_VsaFirst), 1))))</_VsaRelative>
    <_VsaSlash>$(_VsaRelative.IndexOf('/'))</_VsaSlash>
    <VsaModule Condition="'$(_VsaSlash)' == '-1'">$(_VsaRelative)</VsaModule>
    <VsaModule Condition="'$(_VsaSlash)' != '-1'">$(_VsaRelative.Substring(0, $(_VsaSlash)))</VsaModule>
    <_VsaFolder Condition="'$(_VsaSlash)' != '-1'">$(_VsaRelative.Substring($([MSBuild]::Add($(_VsaSlash), 1))))</_VsaFolder>
    <VsaModuleDir>$(_VsaGroupRoot)$(VsaRootFolder)/$(VsaModule)/</VsaModuleDir>
    <VsaLayer Condition="'$(_VsaSlash)' == '-1'">Module</VsaLayer>
    <VsaLayer Condition="'$(_VsaFolder)' == 'Projects' and $(MSBuildProjectName.StartsWith('$(VsaModule).'))">$(MSBuildProjectName.Substring($([MSBuild]::Add($(VsaModule.Length), 1))).Replace('.', '/'))</VsaLayer>
    <!-- The project of this layer in another module: <Name>/<_VsaLayerDir><Name><_VsaLayerSuffix>.csproj.
         Module root: Pipeline/Pipeline.csproj. Layer: Pipeline/Projects/Pipeline.Contracts.Events.csproj. -->
    <_VsaLayerDir Condition="'$(VsaLayer)' != '' and '$(VsaLayer)' != 'Module'">Projects/</_VsaLayerDir>
    <_VsaLayerSuffix Condition="'$(VsaLayer)' != '' and '$(VsaLayer)' != 'Module'">.$(VsaLayer.Replace('/', '.'))</_VsaLayerSuffix>
    <!-- A module project in another folder, or with a wrong name: VSA0004. It gets no layer rules. -->
    <_VsaMisplaced Condition="'$(VsaLayer)' == ''">true</_VsaMisplaced>
    <_VsaMessageLayer Condition="'$(VsaLayer)' == 'Contracts/Requests' or '$(VsaLayer)' == 'Contracts/Events' or '$(VsaLayer)' == 'Contracts/Commands' or '$(VsaLayer)' == 'Handlers/Requests' or '$(VsaLayer)' == 'Handlers/Events' or '$(VsaLayer)' == 'Handlers/Commands'">true</_VsaMessageLayer>
    <!-- In a module, the router gives the files of these layers. In a plugin module, the folder of the layer gives them. -->
    <_VsaRouted Condition="'$(_VsaMessageLayer)' == 'true' and '$(VsaRootFolder)' == 'Features'">true</_VsaRouted>
    <!-- Each module project takes only the files that VSA.Sdk gives it. -->
    <EnableDefaultCompileItems Condition="'$(VsaLayer)' != ''">false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- The files of each project. VsaRule="true" marks them, so a Compile item written by hand stands out (VSA0006). -->
  <ItemGroup Condition="'$(VsaLayer)' == 'Module'">
    <Compile Include="$(VsaModuleDir)*.cs" VsaRule="true" />
    <!-- The IDE shows the slice files under the module root, and dotnet watch sees them. The root does not compile them. -->
    <None Include="$(VsaModuleDir)Slices/**/*.cs" Link="Slices/%(RecursiveDir)%(Filename)%(Extension)" />
    <Watch Include="$(VsaModuleDir)Slices/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Infrastructure' or '$(VsaLayer)' == 'Presenters' or '$(VsaLayer)' == 'Domain/Shared' or ('$(_VsaMessageLayer)' == 'true' and '$(VsaRootFolder)' == 'Plugins')">
    <Compile Include="$(VsaModuleDir)$(VsaLayer)/**/*.cs" VsaRule="true" Link="$(VsaLayer)/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Domain/Shared/ is the published domain. Its own project compiles it, so Domain leaves it out. -->
  <!-- Domain.Shared gets no project of a module: the published domain of one module does not depend on another module.
       A reference to the Domain.Shared of each module would be a cycle between two modules. -->
  <ItemGroup Condition="'$(VsaLayer)' == 'Domain/Shared'" />
  <ItemGroup Condition="'$(VsaLayer)' == 'Domain'">
    <Compile Include="$(VsaModuleDir)Domain/**/*.cs" Exclude="$(VsaModuleDir)Domain/Shared/**" VsaRule="true" Link="Domain/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The router task. Package mode: the DLL is in tasks/ next to this file.
       Source mode: framework/Sdk/Tasks builds the DLL, and MSBuild runs it in its own process (TaskHostFactory),
       so a rebuild of the task never finds the DLL locked by a running MSBuild node. -->
  <PropertyGroup>
    <_VsaTasksAssembly Condition="'$(VsaFrameworkSourceDir)' == ''">$(MSBuildThisFileDirectory)tasks/VSA.Sdk.Tasks.dll</_VsaTasksAssembly>
    <_VsaTasksAssembly Condition="'$(VsaFrameworkSourceDir)' != ''">$(VsaFrameworkSourceDir)Sdk/Tasks/bin/any/netstandard2.0/VSA.Sdk.Tasks.dll</_VsaTasksAssembly>
  </PropertyGroup>
  <UsingTask TaskName="VsaRouteSliceFiles" AssemblyFile="$(_VsaTasksAssembly)" Condition="'$(VsaFrameworkSourceDir)' == ''" />
  <UsingTask TaskName="VsaRouteSliceFiles" AssemblyFile="$(_VsaTasksAssembly)" TaskFactory="TaskHostFactory" Condition="'$(VsaFrameworkSourceDir)' != ''" />
  <ItemGroup Condition="'$(VsaFrameworkSourceDir)' != '' and '$(_VsaRouted)' == 'true'">
    <ProjectReference Include="$(VsaFrameworkSourceDir)Sdk/Tasks/VSA.Sdk.Tasks.csproj" VsaRule="true" ReferenceOutputAssembly="false" Private="false"
                      UndefineProperties="TargetFramework" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <!-- BeforeCompile is the extension point of CompileDependsOn. The files are then in @(Compile) for the build,
       the design-time build of the IDE, the analyzer config and the input cache of CoreCompile. -->
  <Target Name="_VsaRouteSlices" BeforeTargets="BeforeCompile" Condition="'$(_VsaRouted)' == 'true'">
    <ItemGroup>
      <_VsaSliceSource Include="$(VsaModuleDir)Slices/**/*.cs" />
      <!-- The layer folders of the plugin modules: the router reads their types as bases. -->
      <_VsaKnownSource Include="$(VsaPluginsDir)*/Contracts/**/*.cs;$(VsaPluginsDir)*/Handlers/**/*.cs" />
    </ItemGroup>
    <VsaRouteSliceFiles SlicesDir="$(VsaModuleDir)Slices/" Files="@(_VsaSliceSource)" KnownFiles="@(_VsaKnownSource)" Layer="$(VsaLayer)">
      <Output TaskParameter="LayerFiles" ItemName="Compile" />
    </VsaRouteSliceFiles>
  </Target>

  <!-- EF Core writes the files in Infrastructure/Migrations/, so they are generated code: the style rules do not check them.
       EF does not mark each file as generated, so a global config in obj/ marks each one (generated_code = true). -->
  <Target Name="_VsaGeneratedMigrations" BeforeTargets="CoreCompile" DependsOnTargets="_VsaMigrationConfig" Condition="'$(VsaLayer)' == 'Infrastructure'">
    <ItemGroup>
      <EditorConfigFiles Include="$(_VsaMigrationConfig)" />
    </ItemGroup>
  </Target>
  <Target Name="_VsaMigrationConfig" Condition="'$(VsaLayer)' == 'Infrastructure'">
    <PropertyGroup>
      <_VsaMigrationConfig>$(IntermediateOutputPath)VSA.Migrations.globalconfig</_VsaMigrationConfig>
    </PropertyGroup>
    <ItemGroup>
      <_VsaMigration Include="@(Compile->'%(FullPath)')" Condition="$([System.String]::Copy('%(Compile.FullPath)').Replace('\', '/').Contains('/Infrastructure/Migrations/'))" />
      <_VsaMigrationLine Include="is_global = true" />
      <_VsaMigrationLine Include="@(_VsaMigration->'[%(FullPath)]%0Agenerated_code = true'->Replace('\', '/'))" />
    </ItemGroup>
    <WriteLinesToFile File="$(_VsaMigrationConfig)" Lines="@(_VsaMigrationLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- The analyzers read the root folder: VSA1003 does not check a plugin module. -->
  <ItemGroup Condition="'$(VsaLayer)' != ''">
    <CompilerVisibleProperty Include="VsaRootFolder" />
    <CompilerVisibleProperty Include="VsaLayer" />
  </ItemGroup>

  <!-- The framework base of each layer. Path is the project folder under framework/ in source mode. -->
  <ItemGroup Condition="'$(VsaLayer)' != ''">
    <_VsaFramework Include="VSA.Analyzers" Path="Analyzers" Private="true" />
    <_VsaFramework Include="VSA.Analyzers.Markers" Path="Analyzers/Markers" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Domain'">
    <_VsaFramework Include="VSA.Domain" Path="Core/Domain" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Infrastructure'">
    <_VsaFramework Include="VSA.Infrastructure" Path="Core/Infrastructure/Core" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Contracts/Requests'">
    <_VsaFramework Include="VSA.Contracts.Requests" Path="Core/Contracts/Requests" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Contracts/Events'">
    <_VsaFramework Include="VSA.Contracts.Events" Path="Core/Contracts/Events" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Contracts/Commands'">
    <_VsaFramework Include="VSA.Contracts.Commands" Path="Core/Contracts/Commands" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Handlers/Requests'">
    <_VsaFramework Include="VSA.Handlers.Requests" Path="Core/Handlers/Requests" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Handlers/Events'">
    <_VsaFramework Include="VSA.Handlers.Events" Path="Core/Handlers/Events" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Handlers/Commands'">
    <_VsaFramework Include="VSA.Handlers.Commands" Path="Core/Handlers/Commands" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Presenters'">
    <_VsaFramework Include="VSA.Presenters" Path="Core/Presenters" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Module'">
    <_VsaFramework Include="VSA.Module" Path="Core/Module" />
  </ItemGroup>

  <!-- Source mode: project references into framework/. -->
  <ItemGroup Condition="'$(VsaFrameworkSourceDir)' != ''">
    <ProjectReference Include="@(_VsaFramework->'$(VsaFrameworkSourceDir)%(Path)/%(Identity).csproj')" VsaRule="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaFrameworkSourceDir)' != ''">
    <ProjectReference Update="$(VsaFrameworkSourceDir)Analyzers/VSA.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- Package mode: package references with the version of this SDK.
       With central package management, a PackageReference cannot set Version, so use VersionOverride. -->
  <PropertyGroup Condition="'$(VsaFrameworkSourceDir)' == ''">
    <_VsaV Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(VsaVersion)</_VsaV>
    <_VsaVO Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(VsaVersion)</_VsaVO>
  </PropertyGroup>
  <ItemGroup Condition="'$(VsaFrameworkSourceDir)' == ''">
    <PackageReference Include="@(_VsaFramework)" Version="$(_VsaV)" VersionOverride="$(_VsaVO)" VsaRule="true" />
    <PackageReference Update="VSA.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- The references inside the module. The wildcard finds only the layers that the module has:
       Projects/*.Domain.csproj is Projects/<Module>.Domain.csproj, because VSA0004 checks each name. -->
  <!-- Exposed, not private: the types of the published domain are in the public types of Domain and of the contracts. -->
  <ItemGroup Condition="'$(VsaLayer)' == 'Domain'">
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Domain.Shared.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Infrastructure'">
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Domain.csproj;$(VsaModuleDir)Projects/*.Domain.Shared.csproj" PrivateAssets="all" />
  </ItemGroup>
  <!-- anyModule: a message carries the keys and ids of all modules, and of all plugin modules. -->
  <ItemGroup Condition="'$(VsaLayer)' == 'Contracts/Requests'">
    <ProjectReference VsaRule="true" Include="$(VsaFeaturesDir)*/Projects/*.Domain.Shared.csproj;$(VsaPluginsDir)*/Projects/*.Domain.Shared.csproj" Condition="'$(VsaRootFolder)' == 'Features'" />
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Domain.Shared.csproj" Condition="'$(VsaRootFolder)' == 'Plugins'" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Contracts/Events'">
    <ProjectReference VsaRule="true" Include="$(VsaFeaturesDir)*/Projects/*.Domain.Shared.csproj;$(VsaPluginsDir)*/Projects/*.Domain.Shared.csproj" Condition="'$(VsaRootFolder)' == 'Features'" />
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Domain.Shared.csproj" Condition="'$(VsaRootFolder)' == 'Plugins'" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Contracts/Commands'">
    <ProjectReference VsaRule="true" Include="$(VsaFeaturesDir)*/Projects/*.Domain.Shared.csproj;$(VsaPluginsDir)*/Projects/*.Domain.Shared.csproj" Condition="'$(VsaRootFolder)' == 'Features'" />
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Domain.Shared.csproj" Condition="'$(VsaRootFolder)' == 'Plugins'" />
  </ItemGroup>
  <!-- anyModule: each handler reads the published domain of all modules, and sends the commands of all modules. -->
  <ItemGroup Condition="'$(VsaLayer)' == 'Handlers/Requests'">
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Domain.csproj;$(VsaModuleDir)Projects/*.Infrastructure.csproj" PrivateAssets="all" />
    <!-- A module handler gets the Domain and the Infrastructure of each plugin module, as it gets its own: a plugin module is a base. -->
    <ProjectReference VsaRule="true" Include="$(VsaPluginsDir)*/Projects/*.Domain.csproj;$(VsaPluginsDir)*/Projects/*.Infrastructure.csproj" PrivateAssets="all" Condition="'$(VsaRootFolder)' == 'Features'" />
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Contracts.Requests.csproj;$(VsaModuleDir)Projects/*.Contracts.Events.csproj" PrivateAssets="all" />
    <ProjectReference VsaRule="true" Include="$(VsaFeaturesDir)*/Projects/*.Domain.Shared.csproj;$(VsaFeaturesDir)*/Projects/*.Contracts.Commands.csproj;$(VsaPluginsDir)*/Projects/*.Domain.Shared.csproj;$(VsaPluginsDir)*/Projects/*.Contracts.Commands.csproj" PrivateAssets="all" Condition="'$(VsaRootFolder)' == 'Features'" />
    <!-- A plugin module uses no module: its handlers get its own published domain and commands only. -->
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Domain.Shared.csproj;$(VsaModuleDir)Projects/*.Contracts.Commands.csproj" PrivateAssets="all" Condition="'$(VsaRootFolder)' == 'Plugins'" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Handlers/Events'">
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Domain.csproj;$(VsaModuleDir)Projects/*.Infrastructure.csproj" PrivateAssets="all" />
    <!-- A module handler gets the Domain and the Infrastructure of each plugin module, as it gets its own: a plugin module is a base. -->
    <ProjectReference VsaRule="true" Include="$(VsaPluginsDir)*/Projects/*.Domain.csproj;$(VsaPluginsDir)*/Projects/*.Infrastructure.csproj" PrivateAssets="all" Condition="'$(VsaRootFolder)' == 'Features'" />
    <!-- anyModule: the events of all modules, and of all plugin modules -->
    <ProjectReference VsaRule="true" Include="$(VsaFeaturesDir)*/Projects/*.Contracts.Events.csproj;$(VsaPluginsDir)*/Projects/*.Contracts.Events.csproj" PrivateAssets="all" Condition="'$(VsaRootFolder)' == 'Features'" />
    <ProjectReference VsaRule="true" Include="$(VsaFeaturesDir)*/Projects/*.Domain.Shared.csproj;$(VsaFeaturesDir)*/Projects/*.Contracts.Commands.csproj;$(VsaPluginsDir)*/Projects/*.Domain.Shared.csproj;$(VsaPluginsDir)*/Projects/*.Contracts.Commands.csproj" PrivateAssets="all" Condition="'$(VsaRootFolder)' == 'Features'" />
    <!-- A plugin module uses no module: its handlers get its own published domain and commands only. -->
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Domain.Shared.csproj;$(VsaModuleDir)Projects/*.Contracts.Commands.csproj" PrivateAssets="all" Condition="'$(VsaRootFolder)' == 'Plugins'" />
    <!-- A plugin module: its own events. Exposed, so the Handlers.Events of a plugin module in VsaPluginUses gives its events too. -->
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Contracts.Events.csproj" Condition="'$(VsaRootFolder)' == 'Plugins'" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Handlers/Commands'">
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Domain.csproj;$(VsaModuleDir)Projects/*.Infrastructure.csproj" PrivateAssets="all" />
    <!-- A module handler gets the Domain and the Infrastructure of each plugin module, as it gets its own: a plugin module is a base. -->
    <ProjectReference VsaRule="true" Include="$(VsaPluginsDir)*/Projects/*.Domain.csproj;$(VsaPluginsDir)*/Projects/*.Infrastructure.csproj" PrivateAssets="all" Condition="'$(VsaRootFolder)' == 'Features'" />
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Contracts.Events.csproj" PrivateAssets="all" />
    <ProjectReference VsaRule="true" Include="$(VsaFeaturesDir)*/Projects/*.Domain.Shared.csproj;$(VsaFeaturesDir)*/Projects/*.Contracts.Commands.csproj;$(VsaPluginsDir)*/Projects/*.Domain.Shared.csproj;$(VsaPluginsDir)*/Projects/*.Contracts.Commands.csproj" PrivateAssets="all" Condition="'$(VsaRootFolder)' == 'Features'" />
    <!-- A plugin module uses no module: its handlers get its own published domain and commands only. -->
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Domain.Shared.csproj;$(VsaModuleDir)Projects/*.Contracts.Commands.csproj" PrivateAssets="all" Condition="'$(VsaRootFolder)' == 'Plugins'" />
  </ItemGroup>
  <!-- A presenter hears the events of its own module only (D-21). -->
  <ItemGroup Condition="'$(VsaLayer)' == 'Presenters'">
    <!-- The events that a presenter shows (IPresenterEvent): the events of its own module only.
         A view that shows more than one module shows the presenter of each module. -->
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Contracts.Requests.csproj;$(VsaModuleDir)Projects/*.Contracts.Events.csproj" PrivateAssets="all" />
    <!-- anyModule: a presenter reads the published domain of all modules, and of all plugin modules. -->
    <ProjectReference VsaRule="true" Include="$(VsaFeaturesDir)*/Projects/*.Domain.Shared.csproj;$(VsaPluginsDir)*/Projects/*.Domain.Shared.csproj" PrivateAssets="all" Condition="'$(VsaRootFolder)' == 'Features'" />
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects/*.Domain.Shared.csproj" PrivateAssets="all" Condition="'$(VsaRootFolder)' == 'Plugins'" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Module'">
    <!-- Exposed, not private: the host loads the handlers and presenters at run time,
         so it must get every module assembly. -->
    <_VsaLayerProject Include="$(VsaModuleDir)Projects/*.csproj" />
    <ProjectReference VsaRule="true" Include="@(_VsaLayerProject)" />
  </ItemGroup>

  <!-- The plugin modules. A module layer gets the same layer of each plugin module, and a module root gets each plugin root.
       A plugin layer gets the same layer of the plugin modules in VsaPluginUses only (VsaPluginUses: plugin module names, with ";").
       So a plugin module uses another one only if it names it. Two plugin modules that name each other are a cycle,
       and MSBuild stops the build. Exposed, not private, as the framework base of each layer is.
       No rule gives a module to a plugin module. -->
  <ItemGroup Condition="'$(VsaRootFolder)' == 'Features' and '$(VsaLayer)' != ''">
    <ProjectReference VsaRule="true" Include="$(VsaPluginsDir)*/$(_VsaLayerDir)*$(_VsaLayerSuffix).csproj" />
  </ItemGroup>
  <!-- VsaPluginUses with no spaces and no empty names: " A ;\n B ;" is "A;B". _VsaCheckUses checks each name.
       Unescape: MSBuild escapes the result of a property function, so ";" and "*" would be text, not a list and a glob. -->
  <PropertyGroup Condition="'$(VsaPluginUses)' != ''">
    <_VsaPluginUseNames>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace($([System.Text.RegularExpressions.Regex]::Replace('$(VsaPluginUses)', '\s+', '')), ';+', ';').Trim(';'))))</_VsaPluginUseNames>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VsaRootFolder)' == 'Plugins' and '$(VsaLayer)' != '' and '$(_VsaPluginUseNames)' != ''">
    <_VsaPluginUses>$(VsaPluginsDir)$([MSBuild]::Unescape($(_VsaPluginUseNames.Replace(';', '/$(_VsaLayerDir)*$(_VsaLayerSuffix).csproj;$(VsaPluginsDir)'))))/$(_VsaLayerDir)*$(_VsaLayerSuffix).csproj</_VsaPluginUses>
  </PropertyGroup>
  <ItemGroup Condition="'$(_VsaPluginUses)' != ''">
    <ProjectReference VsaRule="true" Include="$(_VsaPluginUses)" />
  </ItemGroup>


  <!-- The module root finds each .cs file that no project compiles (VSA0006). A layer folder counts only if its project exists. -->
  <PropertyGroup Condition="'$(VsaLayer)' == 'Module'">
    <_VsaCompiled>$(VsaModuleDir)*.cs;$(VsaModuleDir)Projects/**;$(VsaModuleDir)obj/**;$(VsaModuleDir)bin/**</_VsaCompiled>
    <_VsaCompiled Condition="Exists('$(VsaModuleDir)Projects/$(VsaModule).Domain.csproj')">$(_VsaCompiled);$(VsaModuleDir)Domain/**</_VsaCompiled>
    <_VsaCompiled Condition="Exists('$(VsaModuleDir)Projects/$(VsaModule).Domain.Shared.csproj')">$(_VsaCompiled);$(VsaModuleDir)Domain/Shared/**</_VsaCompiled>
    <_VsaCompiled Condition="Exists('$(VsaModuleDir)Projects/$(VsaModule).Infrastructure.csproj')">$(_VsaCompiled);$(VsaModuleDir)Infrastructure/**</_VsaCompiled>
    <_VsaCompiled Condition="Exists('$(VsaModuleDir)Projects/$(VsaModule).Presenters.csproj')">$(_VsaCompiled);$(VsaModuleDir)Presenters/**</_VsaCompiled>
    <_VsaCompiled Condition="'$(VsaRootFolder)' == 'Features' and (Exists('$(VsaModuleDir)Projects/$(VsaModule).Handlers.Requests.csproj') or Exists('$(VsaModuleDir)Projects/$(VsaModule).Handlers.Events.csproj') or Exists('$(VsaModuleDir)Projects/$(VsaModule).Handlers.Commands.csproj') or Exists('$(VsaModuleDir)Projects/$(VsaModule).Contracts.Requests.csproj') or Exists('$(VsaModuleDir)Projects/$(VsaModule).Contracts.Events.csproj') or Exists('$(VsaModuleDir)Projects/$(VsaModule).Contracts.Commands.csproj'))">$(_VsaCompiled);$(VsaModuleDir)Slices/**</_VsaCompiled>
  </PropertyGroup>
  <!-- A plugin module: the folder of each message layer counts only if its project exists. Slices/ is an error of its own. -->
  <PropertyGroup Condition="'$(VsaLayer)' == 'Module' and '$(VsaRootFolder)' == 'Plugins'">
    <_VsaCompiled Condition="Exists('$(VsaModuleDir)Projects/$(VsaModule).Contracts.Requests.csproj')">$(_VsaCompiled);$(VsaModuleDir)Contracts/Requests/**</_VsaCompiled>
    <_VsaCompiled Condition="Exists('$(VsaModuleDir)Projects/$(VsaModule).Contracts.Events.csproj')">$(_VsaCompiled);$(VsaModuleDir)Contracts/Events/**</_VsaCompiled>
    <_VsaCompiled Condition="Exists('$(VsaModuleDir)Projects/$(VsaModule).Contracts.Commands.csproj')">$(_VsaCompiled);$(VsaModuleDir)Contracts/Commands/**</_VsaCompiled>
    <_VsaCompiled Condition="Exists('$(VsaModuleDir)Projects/$(VsaModule).Handlers.Requests.csproj')">$(_VsaCompiled);$(VsaModuleDir)Handlers/Requests/**</_VsaCompiled>
    <_VsaCompiled Condition="Exists('$(VsaModuleDir)Projects/$(VsaModule).Handlers.Events.csproj')">$(_VsaCompiled);$(VsaModuleDir)Handlers/Events/**</_VsaCompiled>
    <_VsaCompiled Condition="Exists('$(VsaModuleDir)Projects/$(VsaModule).Handlers.Commands.csproj')">$(_VsaCompiled);$(VsaModuleDir)Handlers/Commands/**</_VsaCompiled>
  </PropertyGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Module' and '$(VsaRootFolder)' == 'Plugins'">
    <_VsaPluginSlice Include="$(VsaModuleDir)Slices/**/*.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(VsaLayer)' == 'Module' and '$(VsaRootFolder)' == 'Plugins'">
    <_VsaCompiled>$(_VsaCompiled);$(VsaModuleDir)Slices/**</_VsaCompiled>
    <_VsaFolders>Domain/, Domain/Shared/, Infrastructure/, Presenters/, Contracts/Requests/, Contracts/Events/, Contracts/Commands/, Handlers/Requests/, Handlers/Events/ or Handlers/Commands/</_VsaFolders>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VsaLayer)' == 'Module' and '$(VsaRootFolder)' == 'Features'">
    <_VsaFolders>Domain/, Domain/Shared/, Infrastructure/, Presenters/ or a slice in Slices/</_VsaFolders>
  </PropertyGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Module'">
    <_VsaUncompiled Include="$(VsaModuleDir)**/*.cs" Exclude="$(_VsaCompiled)" />
    <!-- Domain leaves out Domain/Shared/, so these files need the Domain.Shared project. -->
    <_VsaUncompiled Include="$(VsaModuleDir)Domain/Shared/**/*.cs" Exclude="@(_VsaUncompiled)" Folder="Domain/Shared/" Condition="!Exists('$(VsaModuleDir)Projects/$(VsaModule).Domain.Shared.csproj')" />
  </ItemGroup>

  <!-- All VSA build checks. The lists come from evaluation (here and in Sdk.targets), so they do not depend on the targets
       that ran before. CollectPackageReferences runs in restore; ResolveProjectReferences runs in each build and design-time build. -->
  <Target Name="_VsaCheck" BeforeTargets="CollectPackageReferences;ResolveProjectReferences" Condition="'$(VsaModule)' != ''">
    <Error Condition="'$(_VsaMisplaced)' == 'true'" Code="VSA0004"
           Text="$(MSBuildProjectName) is in $(_VsaRelative)/. A module has its root project in $(VsaRootFolder)/$(VsaModule)/ and its layer projects in $(VsaRootFolder)/$(VsaModule)/Projects/, named $(VsaModule).&lt;Layer&gt;, for example $(VsaModule).Domain." />
    <ItemGroup>
      <!-- The path in the module with "/" on each OS. -->
      <_VsaUncompiledPath Include="@(_VsaUncompiled)" Path="%(_VsaUncompiled.Folder)$([System.String]::Copy('%(_VsaUncompiled.RecursiveDir)').Replace('\', '/'))%(_VsaUncompiled.Filename)%(_VsaUncompiled.Extension)" />
      <_VsaPluginSlicePath Include="@(_VsaPluginSlice)" Path="Slices/$([System.String]::Copy('%(_VsaPluginSlice.RecursiveDir)').Replace('\', '/'))%(_VsaPluginSlice.Filename)%(_VsaPluginSlice.Extension)" />
      <_VsaHandReference Include="@(_VsaDeclaredReference)" Condition="'%(_VsaDeclaredReference.Kind)' == 'Project' or $([System.String]::Copy('%(Identity)').StartsWith('VSA.'))" />
    </ItemGroup>
    <Error Condition="'@(_VsaHandReference)' != ''" Code="VSA0001"
           Text="$(MSBuildProjectName) is in layer $(VsaLayer). Its references come from VSA.Sdk. Remove these references: @(_VsaHandReference)" />
    <Error Condition="'@(_VsaDeclaredCompile)' != ''" Code="VSA0006"
           Text="$(MSBuildProjectName) has Compile items written by hand: @(_VsaDeclaredCompile). VSA.Sdk gives each project its files. Remove them, and put each file in the folder of its layer or in a slice." />
    <Error Condition="'@(_VsaUncompiled)' != ''" Code="VSA0006"
           Text="No project of module $(VsaModule) compiles these files: @(_VsaUncompiledPath->'%(Path)'). Move each file to $(_VsaFolders), and make sure that the module has the project of that folder." />
    <Error Condition="'@(_VsaPluginSlice)' != ''" Code="VSA0006"
           Text="$(VsaModule) is a plugin module, so it has no slices: @(_VsaPluginSlicePath->'%(Path)'). A plugin module has the layout of the framework. Move each file to the folder of its layer, for example Handlers/Commands/, and make sure that the module has the project of that layer." />
    <Error Condition="'$(VsaUnityCopy)' == 'true' and !$([System.String]::Copy(';$(TargetFrameworks);$(TargetFramework);').Contains(';netstandard2.1;'))" Code="VSA0007"
           Text="$(MSBuildProjectName) is a module project of a Unity app, and it targets $(TargetFramework)$(TargetFrameworks). Unity loads only netstandard2.1. Set TargetFramework to netstandard2.1 (for example in Directory.Build.props), or set VsaUnityCopy to false if Unity does not use this module." />
  </Target>

  <!-- Each name in VsaPluginUses is another plugin module that has this layer. Only a plugin layer has VsaPluginUses. -->
  <Target Name="_VsaCheckUses" BeforeTargets="CollectPackageReferences;ResolveProjectReferences" Condition="'$(_VsaPluginUseNames)' != ''">
    <ItemGroup>
      <_VsaUse Include="$(_VsaPluginUseNames)" />
      <_VsaBadUse Include="@(_VsaUse)" Condition="'%(Identity)' == '$(VsaModule)'
          or !$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^[A-Za-z_][A-Za-z0-9_]*$'))
          or !Exists('$(VsaPluginsDir)%(Identity)/$(_VsaLayerDir)%(Identity)$(_VsaLayerSuffix).csproj')" />
    </ItemGroup>
    <Error Condition="'$(VsaRootFolder)' != 'Plugins'" Code="VSA0002"
           Text="$(MSBuildProjectName) sets VsaPluginUses, but it is not in a plugin module. A module gets each plugin module from VSA.Sdk. Remove VsaPluginUses." />
    <Error Condition="'$(VsaRootFolder)' == 'Plugins' and '@(_VsaBadUse)' != ''" Code="VSA0002"
           Text="$(MSBuildProjectName) is in layer $(VsaLayer) of the plugin module $(VsaModule). VsaPluginUses names these modules, but they are not other plugin modules with the layer $(VsaLayer): @(_VsaBadUse). Name only folders in $(VsaPluginsDir) that have $(_VsaLayerDir)&lt;Name&gt;$(_VsaLayerSuffix).csproj." />
  </Target>

  <!-- A project in a Features or Plugins folder that is not a root folder of the app root gets no rules. That is an error,
       because the build would fail later with missing references. -->
  <Target Name="_VsaCheckRoot" BeforeTargets="CollectPackageReferences;ResolveProjectReferences"
          Condition="'$(VsaRootFolder)' == '' and ($(_VsaCheckedPath.Contains('/Features/')) or $(_VsaCheckedPath.Contains('/Plugins/')))">
    <Error Code="VSA0003"
           Text="$(MSBuildProjectName) is in a Features or Plugins folder, but not in $(_VsaGroupRoot)Features/ or $(_VsaGroupRoot)Plugins/. The app root is the folder of global.json ($(VsaAppRoot)). Move the project, or set VsaAppRoot to the app folder." />
  </Target>
  <!-- A Unity app. Unity does not run VSA.Sdk: it gets the module DLLs, and the .NET tests compile the module sources of Assets/.
       Each module project copies its DLL and PDB to VsaUnityPluginsDir after the netstandard2.1 build. VsaUnityCopy=false stops it. -->
  <PropertyGroup Condition="'$(VsaUnityProject)' == 'true' and '$(VsaLayer)' != ''">
    <VsaUnityCopy Condition="'$(VsaUnityCopy)' == ''">true</VsaUnityCopy>
    <VsaUnityPluginsDir Condition="'$(VsaUnityPluginsDir)' == ''">$(_VsaRoot)Assets/Plugins/VSA/</VsaUnityPluginsDir>
  </PropertyGroup>
  <Target Name="_VsaCopyToUnity" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(VsaUnityCopy)' == 'true' and '$(TargetFramework)' == 'netstandard2.1'">
    <ItemGroup>
      <_VsaUnityFile Include="$(TargetPath)" />
      <_VsaUnityFile Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_VsaUnityFile)" DestinationFolder="$(VsaUnityPluginsDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- netstandard2.1 does not have the type that the compiler needs for init and records. -->
  <ItemGroup Condition="'$(VsaLayer)' != '' and '$(TargetFramework)' == 'netstandard2.1'">
    <Compile Include="$(MSBuildThisFileDirectory)Polyfills/*.cs" VsaRule="true" Visible="false" />
  </ItemGroup>

  <!-- The .NET test project of a Unity app: a project in VsaUnitySource, not in a module, with a name that ends in ".Tests".
       It also compiles the module sources in Assets/<VsaUnityApp>/Features/ and Plugins/, so dotnet test runs them.
       It gets the framework bases of the module layers and each module project in VsaUnitySource.
       VsaUnityApp is the one folder in Assets/ (not Assets/Plugins/) with Features/, Plugins/ or Views/, as in VsaDefinition. -->
  <PropertyGroup Condition="'$(VsaUnityProject)' == 'true' and '$(VsaRootFolder)' == '' and '$(VsaUnityModuleSources)' == '' and $(MSBuildProjectName.EndsWith('.Tests')) and $(_VsaPath.ToLowerInvariant().StartsWith($(_VsaGroupRoot.ToLowerInvariant())))">
    <VsaUnityModuleSources>true</VsaUnityModuleSources>
  </PropertyGroup>
  <ItemGroup Condition="'$(VsaUnityModuleSources)' == 'true'">
    <_VsaFramework Include="VSA.Analyzers.Markers" Path="Analyzers/Markers" />
    <_VsaFramework Include="VSA.Module" Path="Core/Module" />
    <_VsaFramework Include="VSA.Domain" Path="Core/Domain" />
    <_VsaFramework Include="VSA.Infrastructure" Path="Core/Infrastructure/Core" />
    <_VsaFramework Include="VSA.Contracts.Requests" Path="Core/Contracts/Requests" />
    <_VsaFramework Include="VSA.Contracts.Events" Path="Core/Contracts/Events" />
    <_VsaFramework Include="VSA.Contracts.Commands" Path="Core/Contracts/Commands" />
    <_VsaFramework Include="VSA.Handlers.Requests" Path="Core/Handlers/Requests" />
    <_VsaFramework Include="VSA.Handlers.Events" Path="Core/Handlers/Events" />
    <_VsaFramework Include="VSA.Handlers.Commands" Path="Core/Handlers/Commands" />
    <_VsaFramework Include="VSA.Presenters" Path="Core/Presenters" />
    <ProjectReference VsaRule="true" Include="$(_VsaGroupRoot)Features/*/*.csproj;$(_VsaGroupRoot)Plugins/*/*.csproj" />
  </ItemGroup>
  <Target Name="_VsaUnitySources" BeforeTargets="BeforeCompile" Condition="'$(VsaUnityModuleSources)' == 'true'">
    <ItemGroup Condition="'$(VsaUnityApp)' == '' and Exists('$(_VsaRoot)Assets')">
      <_VsaUnityApp Include="$([System.IO.Directory]::GetDirectories('$(_VsaRoot)Assets'))" />
      <_VsaUnityApp Remove="@(_VsaUnityApp)" Condition="'%(Filename)%(Extension)' == 'Plugins' or !(Exists('%(FullPath)/Features') or Exists('%(FullPath)/Plugins') or Exists('%(FullPath)/Views'))" />
    </ItemGroup>
    <ItemGroup Condition="'$(VsaUnityApp)' != ''">
      <_VsaUnityApp Include="$(_VsaRoot)Assets/$(VsaUnityApp)" />
    </ItemGroup>
    <Error Condition="'@(_VsaUnityApp->Count())' &gt; 1" Code="VSA0008"
           Text="$(MSBuildProjectName) compiles the module sources of the Unity app, but Assets/ has more than one app folder: @(_VsaUnityApp->'%(Filename)%(Extension)'). Set VsaUnityApp to the name of the app folder." />
    <PropertyGroup>
      <_VsaUnityAppDir>@(_VsaUnityApp->'%(FullPath)')</_VsaUnityAppDir>
      <_VsaUnityAppName>@(_VsaUnityApp->'%(Filename)%(Extension)')</_VsaUnityAppName>
    </PropertyGroup>
    <ItemGroup Condition="'$(_VsaUnityAppDir)' != ''">
      <_VsaUnitySource Include="$(_VsaUnityAppDir)/Features/**/*.cs" Folder="Features" />
      <_VsaUnitySource Include="$(_VsaUnityAppDir)/Plugins/**/*.cs" Folder="Plugins" />
      <_VsaUnityUse Include="@(_VsaUnitySource)" Condition="$([System.IO.File]::ReadAllText('%(_VsaUnitySource.FullPath)').Contains('UnityEngine'))"
                    Path="%(_VsaUnitySource.Folder)/$([System.String]::Copy('%(_VsaUnitySource.RecursiveDir)').Replace('\', '/'))%(_VsaUnitySource.Filename)%(_VsaUnitySource.Extension)" />
      <Compile Include="@(_VsaUnitySource)" Link="$(_VsaUnityAppName)/%(_VsaUnitySource.Folder)/%(_VsaUnitySource.RecursiveDir)%(_VsaUnitySource.Filename)%(_VsaUnitySource.Extension)" />
    </ItemGroup>
    <Error Condition="'@(_VsaUnityUse)' != ''" Code="VSA0008"
           Text="These module sources in Assets/$(_VsaUnityAppName)/ use UnityEngine: @(_VsaUnityUse->'%(Path)'). The .NET tests compile each module, and module code does not use Unity. Move the Unity code to a view in Assets/$(_VsaUnityAppName)/Views/." />
  </Target>
</Project>
