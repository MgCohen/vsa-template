<Project>
  <!--
    The layer rules. They follow the layer map.
    The module and the layer come from the path after the last "/Modules/":
      Modules/Notes/                    VsaModule = Notes, VsaLayer = Module (the module root)
      Modules/Notes/Handlers/Requests/  VsaModule = Notes, VsaLayer = Handlers/Requests
    A project that is not under a Modules folder gets no rules.
    "Private" references use PrivateAssets="all". The framework base of each layer is exposed.

    Two modes for the framework references:
      Package mode (consumers): PackageReference to VSA.* with the version of this SDK.
      Source mode (this repository): ProjectReference into framework/, when VsaFrameworkSourceDir is set.
  -->
  <PropertyGroup>
    <_VsaPath>$(MSBuildProjectDirectory.Replace('\', '/').TrimEnd('/'))/</_VsaPath>
    <_VsaAt>$(_VsaPath.LastIndexOf('/Modules/'))</_VsaAt>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_VsaAt)' != '-1'">
    <VsaModulesDir>$(_VsaPath.Substring(0, $([MSBuild]::Add($(_VsaAt), 9))))</VsaModulesDir>
    <_VsaRelative>$(_VsaPath.Substring($([MSBuild]::Add($(_VsaAt), 9))).TrimEnd('/'))</_VsaRelative>
    <_VsaSlash>$(_VsaRelative.IndexOf('/'))</_VsaSlash>
    <VsaModule Condition="'$(_VsaSlash)' == '-1'">$(_VsaRelative)</VsaModule>
    <VsaModule Condition="'$(_VsaSlash)' != '-1'">$(_VsaRelative.Substring(0, $(_VsaSlash)))</VsaModule>
    <VsaLayer Condition="'$(_VsaSlash)' == '-1'">Module</VsaLayer>
    <VsaLayer Condition="'$(_VsaSlash)' != '-1'">$(_VsaRelative.Substring($([MSBuild]::Add($(_VsaSlash), 1))))</VsaLayer>
    <VsaModuleDir>$(VsaModulesDir)$(VsaModule)/</VsaModuleDir>
  </PropertyGroup>

  <!--
    Slice modules keep their layer projects in one folder, Modules/<Module>/Projects/ (Sdk.props sets VsaProjectsFolder).
    The layer comes from the project name, not the folder: Projects/Notes.Contracts.Requests.csproj is Contracts/Requests.
    The code stays in folders by feature, and each project takes its files from them:
      Domain, Infrastructure, Presenters   Domain/**, Infrastructure/**, Presenters/**
      Contracts/Requests                   Slices/**/Request/**
      Contracts/Events                     Slices/**/Event/**
      Slices                               the other files of Slices/**
  -->
  <PropertyGroup Condition="'$(VsaProjectsFolder)' == 'true' and '$(VsaLayer)' == 'Projects'">
    <_VsaProjectLayer Condition="$(MSBuildProjectName.StartsWith('$(VsaModule).'))">$(MSBuildProjectName.Substring($([MSBuild]::Add($(VsaModule.Length), 1))).Replace('.', '/'))</_VsaProjectLayer>
    <VsaLayer>$(_VsaProjectLayer)</VsaLayer>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup>
    <_VsaRequestFiles>$(VsaModuleDir)Slices/**/Request/**/*.cs</_VsaRequestFiles>
    <_VsaEventFiles>$(VsaModuleDir)Slices/**/Event/**/*.cs</_VsaEventFiles>
  </PropertyGroup>
  <ItemGroup Condition="'$(VsaProjectsFolder)' == 'true'">
    <Compile Condition="'$(VsaLayer)' == 'Domain' or '$(VsaLayer)' == 'Infrastructure' or '$(VsaLayer)' == 'Presenters'"
             Include="$(VsaModuleDir)$(VsaLayer)/**/*.cs" Link="$(VsaLayer)/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Condition="'$(VsaLayer)' == 'Contracts/Requests'" Include="$(_VsaRequestFiles)" Link="Slices/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Condition="'$(VsaLayer)' == 'Contracts/Events'" Include="$(_VsaEventFiles)" Link="Slices/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Condition="'$(VsaLayer)' == 'Slices'" Include="$(VsaModuleDir)Slices/**/*.cs" Exclude="$(_VsaRequestFiles);$(_VsaEventFiles)"
             Link="Slices/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="_VsaCheckProjectName" BeforeTargets="CollectPackageReferences;ResolveProjectReferences;CoreCompile"
          Condition="'$(VsaProjectsFolder)' == 'true' and '$(_VsaProjectLayer)' == ''">
    <Error Code="VSA0002" Text="$(MSBuildProjectName) is in $(VsaModuleDir)Projects/. Name it $(VsaModule).&lt;Layer&gt;, for example $(VsaModule).Domain." />
  </Target>

  <!-- The module root compiles only its own files, not the files of its layer projects. -->
  <PropertyGroup Condition="'$(VsaLayer)' == 'Module'">
    <DefaultItemExcludes>$(DefaultItemExcludes);*/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- The framework base of each layer. Path is the project folder under framework/ in source mode. -->
  <ItemGroup Condition="'$(VsaLayer)' != ''">
    <_VsaFramework Include="VSA.Analyzers" Path="Analyzers" Private="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Domain'">
    <_VsaFramework Include="VSA.Domain" Path="Layers/Domain" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Infrastructure'">
    <_VsaFramework Include="VSA.Infrastructure.EfCore" Path="Layers/Infrastructure/EfCore" Private="true" />
    <_VsaFramework Include="VSA.Infrastructure" Path="Layers/Infrastructure/Core" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Contracts/Requests'">
    <_VsaFramework Include="VSA.Contracts.Requests" Path="Layers/Contracts/Requests" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Contracts/Events'">
    <_VsaFramework Include="VSA.Contracts.Events" Path="Layers/Contracts/Events" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Handlers/Requests'">
    <_VsaFramework Include="VSA.Handlers.Requests" Path="Layers/Handlers/Requests" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Handlers/Events'">
    <_VsaFramework Include="VSA.Handlers.Events" Path="Layers/Handlers/Events" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Slices'">
    <_VsaFramework Include="VSA.Handlers.Requests" Path="Layers/Handlers/Requests" />
    <_VsaFramework Include="VSA.Handlers.Events" Path="Layers/Handlers/Events" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Presenters'">
    <_VsaFramework Include="VSA.Presenters" Path="Layers/Presenters" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Module'">
    <_VsaFramework Include="VSA.Infrastructure.EfCore" Path="Layers/Infrastructure/EfCore" Private="true" />
    <_VsaFramework Include="VSA.Module" Path="Layers/Module" />
  </ItemGroup>

  <!-- Source mode: project references into framework/. -->
  <ItemGroup Condition="'$(VsaFrameworkSourceDir)' != ''">
    <ProjectReference Include="@(_VsaFramework->'$(VsaFrameworkSourceDir)%(Path)/%(Identity).csproj')" VsaRule="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaFrameworkSourceDir)' != ''">
    <ProjectReference Update="$(VsaFrameworkSourceDir)Analyzers/VSA.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Update="$(VsaFrameworkSourceDir)Layers/Infrastructure/EfCore/VSA.Infrastructure.EfCore.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Package mode: package references with the version of this SDK.
       With central package management, a PackageReference cannot set Version, so use VersionOverride. -->
  <PropertyGroup Condition="'$(VsaFrameworkSourceDir)' == ''">
    <_VsaV Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(VsaVersion)</_VsaV>
    <_VsaVO Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(VsaVersion)</_VsaVO>
  </PropertyGroup>
  <ItemGroup Condition="'$(VsaFrameworkSourceDir)' == ''">
    <PackageReference Include="@(_VsaFramework)" Version="$(_VsaV)" VersionOverride="$(_VsaVO)" VsaRule="true" />
    <PackageReference Update="VSA.Analyzers;VSA.Infrastructure.EfCore" PrivateAssets="all" />
  </ItemGroup>

  <!-- The references inside the module. Each reference has two forms: the layer folder, and the Projects folder of a slice module.
       Only one form finds a project, so a module can use either layout. -->
  <ItemGroup Condition="'$(VsaLayer)' == 'Infrastructure'">
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Domain/*.csproj;$(VsaModuleDir)Projects*/$(VsaModule).Domain.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Handlers/Requests'">
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Domain/*.csproj;$(VsaModuleDir)Infrastructure/*.csproj" PrivateAssets="all" />
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Contracts/Requests/*.csproj;$(VsaModuleDir)Contracts/Events/*.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Handlers/Events'">
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Domain/*.csproj;$(VsaModuleDir)Infrastructure/*.csproj" PrivateAssets="all" />
    <!-- anyModule: the events of all modules -->
    <ProjectReference VsaRule="true" Include="$(VsaModulesDir)*/Contracts/Events/*.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Slices'">
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects*/$(VsaModule).Domain.csproj;$(VsaModuleDir)Projects*/$(VsaModule).Infrastructure.csproj" PrivateAssets="all" />
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Projects*/$(VsaModule).Contracts.Requests.csproj" PrivateAssets="all" />
    <!-- anyModule: the events of all modules, in both layouts. The own module is one of them. -->
    <ProjectReference VsaRule="true" Include="$(VsaModulesDir)*/Contracts/Events/*.csproj;$(VsaModulesDir)*/Projects/*.Contracts.Events.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Presenters'">
    <ProjectReference VsaRule="true" Include="$(VsaModuleDir)Contracts/Requests/*.csproj;$(VsaModuleDir)Projects*/$(VsaModule).Contracts.Requests.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsaLayer)' == 'Module'">
    <!-- Exposed, not private: the host loads the handlers and presenters at run time,
         so it must get every module assembly. -->
    <_VsaLayerProject Include="$(VsaModuleDir)*/*.csproj;$(VsaModuleDir)*/*/*.csproj" />
    <ProjectReference VsaRule="true" Include="@(_VsaLayerProject)" />
  </ItemGroup>

  <!-- The module root records its assembly name (the same as Module.Name), so the host finds it,
       and its layer projects, so the host loads only the layers that exist.
       Keep the keys the same as VSA.Module.ModuleMetadata. Code reads the records through VSA.Module.ModuleRoot. -->
  <Target Name="_VsaRecordLayers" BeforeTargets="GetAssemblyAttributes" Condition="'$(VsaLayer)' == 'Module'">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>VsaModule</_Parameter1>
        <_Parameter2>$(AssemblyName)</_Parameter2>
      </AssemblyAttribute>
      <!-- A module with no layer projects gets no layer record, not one empty record. -->
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'@(_VsaLayerProject)' != ''">
        <_Parameter1>VsaLayerAssembly</_Parameter1>
        <_Parameter2>%(_VsaLayerProject.Filename)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- A module project gets its references only from these rules. A reference written by hand is an error. -->
  <Target Name="_VsaCheckReferences" BeforeTargets="CollectPackageReferences;ResolveProjectReferences" Condition="'$(VsaLayer)' != ''">
    <ItemGroup>
      <_VsaHandReference Include="@(ProjectReference)" Condition="'%(ProjectReference.VsaRule)' != 'true'" />
      <_VsaHandReference Include="@(PackageReference)" Condition="'%(PackageReference.VsaRule)' != 'true' and $([System.String]::Copy('%(Identity)').StartsWith('VSA.'))" />
    </ItemGroup>
    <Error Condition="'@(_VsaHandReference)' != ''" Code="VSA0001"
           Text="$(MSBuildProjectName) is in layer $(VsaLayer). Its references come from VSA.Sdk. Remove these references: @(_VsaHandReference)" />
  </Target>
</Project>
