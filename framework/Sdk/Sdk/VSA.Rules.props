<Project>
  <!-- The setup of the editor rules and the VSA rules. Sdk.props imports it for each VSA.Sdk project.
       The root Directory.Build.props of the VSA repository imports it for the framework and its tests, so they follow the same rules. -->
  <PropertyGroup>
    <_VsaRulesImported>true</_VsaRulesImported>
    <EnforceCodeStyleInBuild Condition="'$(EnforceCodeStyleInBuild)' == ''">true</EnforceCodeStyleInBuild>
    <!-- IDE0005 reports an unused using in the build only when the compiler reads the XML comments. -->
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">true</GenerateDocumentationFile>
    <!-- CS1591: the documentation file is for the code style rules only. Public members do not need XML comments. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The formatting rules are warnings while the team examines them. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IDE0055;IDE0011;IDE0161;IDE2000;IDE0008;IDE0040;IDE2002;IDE0065;IDE0036;IDE0049;IDE0054;IDE1005;IDE0083;IDE0021;IDE0022;IDE0023;IDE0024;IDE0025;IDE0026;IDE0027;IDE0053;IDE0061;IDE1006;IDE0051;IDE0052;IDE0059;IDE0060;IDE0005;IDE0004;IDE0079;CA1052;CA1012;CA2000;CA1849;VSA1008;VSA1009;VSA1010;VSA1011;VSA1012;VSA1013</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- VSA.globalconfig: the built-in .NET rules. VSA.Rules.globalconfig: the values of the VSA rules. -->
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)VSA.globalconfig;$(MSBuildThisFileDirectory)VSA.Rules.globalconfig" />
  </ItemGroup>
</Project>
