<Project Sdk="Microsoft.NET.Sdk">
  <!-- The MSBuild tasks of VSA.Sdk. The VSA.Sdk package holds this DLL and its Roslyn dependencies in Sdk/tasks/.
       .NET Standard 2.0, so it runs in dotnet MSBuild and in Visual Studio MSBuild (.NET Framework). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- MSBuild loads a task with its dependencies from the folder of the task DLL. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- One output folder for all configurations. In a solution build, MSBuild builds the projects that are not in the
         solution (the test fixtures) as Debug, and this project as the solution configuration. The source-mode path
         in VSA.Layers.targets must not depend on the configuration of the project that loads the task. -->
    <OutputPath>bin/any/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- MSBuild gives these assemblies at run time, so they are not copied. -->
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Not PrivateAssets="all": Publish leaves those out, and VSA.Sdk packs the publish output. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
</Project>
