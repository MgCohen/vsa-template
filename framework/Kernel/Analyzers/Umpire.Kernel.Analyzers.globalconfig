# The values of the rules of Umpire.Kernel.Analyzers (UMP0101xx). This file is the only place of these values: no rule has a default.
# The package ships this file, and its build props give it to each project that references the package.
# If a value is missing or not valid, the build reports UMP010001, and that rule does not run.
# A consumer changes a value in the .umpireconfig file of its block. Severity uses the standard key: dotnet_diagnostic.UMP010101.severity = none
# Keys: umpire.<rule ID>.<key> for one rule, umpire.<key> for all rules that read the key. A rule key wins.
# In a list, write a comma between the items: a semicolon starts a comment.
is_global = true
global_level = -1

# Formatting (warnings): the maximum characters in a line, lines in a method and lines in a file.
umpire.UMP010101.max = 120
umpire.UMP010102.max = 40
umpire.UMP010103.max = 300
# UMP010104: one top-level type in a file. true: types with the same name can share a file, for example Module and Module<TSettings>.
umpire.UMP010104.allow_same_name = true
# UMP010105: the order of the members in a type: by kind, then by access, then static before instance (static_first = true).
umpire.UMP010105.kind_order = constant, field, constructor, finalizer, property, event, method, nested_type
umpire.UMP010105.access_order = public, internal, protected_internal, protected, private_protected, private
umpire.UMP010105.static_first = true
