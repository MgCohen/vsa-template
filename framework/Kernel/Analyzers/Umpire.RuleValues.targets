<Project>
  <!-- How the rule values reach a compile. Each analyzer project imports this file. The package holds build/<PackageId>.globalconfig
       and build/<PackageId>.props. NuGet imports that props file in each project that references the package.
       Source mode adds the same files in two more places: Sdk.targets (Umpire.Sdk projects) and Directory.Build.targets (the framework).
       All three add the file to EditorConfigFiles: the compiler reads is_global = true from the file. GlobalAnalyzerConfigFiles
       does not work from a .targets file, because Microsoft.Managed.Core.targets reads it before Sdk.targets and Directory.Build.targets. -->
  <ItemGroup>
    <None Include="$(MSBuildProjectName).globalconfig" Pack="true" PackagePath="build" />
    <None Include="$(MSBuildThisFileDirectory)Umpire.RuleValues.props" Pack="true" PackagePath="build/$(PackageId).props" Visible="false" />
  </ItemGroup>
</Project>
