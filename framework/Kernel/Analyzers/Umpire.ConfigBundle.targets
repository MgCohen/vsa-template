<Project>
  <!-- The kernel analyzer DLL embeds the netstandard2.0 Umpire.Config.dll as a resource. Umpire.Config has no package dependency.
       ConfigReader loads it into a private AssemblyLoadContext, so the reader never meets another copy of Umpire.Config in the
       compiler process. The package holds no dependency next to the analyzer DLLs. -->
  <PropertyGroup>
    <_UmpireConfigProject>$(MSBuildThisFileDirectory)../../Components/Config/Umpire.Config.csproj</_UmpireConfigProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" Visible="false" />
    <ProjectReference Include="$(_UmpireConfigProject)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="_UmpireEmbedConfigTree" BeforeTargets="PrepareResources" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="$(_UmpireConfigProject)" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_UmpireConfigTreeFile" />
    </MSBuild>
    <ItemGroup>
      <EmbeddedResource Include="@(_UmpireConfigTreeFile->'%(FullPath)')" LogicalName="UmpireConfigTree/%(Filename)%(Extension)"
                        WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
  </Target>
</Project>
