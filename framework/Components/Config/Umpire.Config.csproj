<Project Sdk="Microsoft.NET.Sdk">
  <!-- The one reader of the .umpireconfig file (TOML). The engine, the kernel, the analyzers and the umpire tool use it.
       The analyzers run in the compiler, so the reader also targets netstandard2.0. -->
  <PropertyGroup>
    <Description>Reads the .umpireconfig file of an Umpire block (TOML).</Description>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>netstandard2.1;netstandard2.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tomlyn" />
  </ItemGroup>
  <!-- The check entry of this block: the engine checks it with this definition when a checked block uses it. -->
  <ItemGroup>
    <AssemblyMetadata Include="Umpire.Architecture" Value="Umpire.Kernels.LibraryArchitecture, Umpire.Kernels" />
  </ItemGroup>
</Project>
