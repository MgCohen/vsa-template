<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../../../../architecture/Markers/Umpire.Markers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Contracts/Umpire.Messages.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <!-- The registration of the layer uses AppTypes (Umpire.Kernels). Private, so the module projects of this layer do not see Umpire.Kernels. -->
  <ItemGroup>
    <ProjectReference Include="../../../Kernel/Umpire.Kernels.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Umpire.Vsa.Handlers.Commands" />
    <InternalsVisibleTo Include="Umpire.Vsa.Handlers.Events" />
    <InternalsVisibleTo Include="Umpire.Vsa.Handlers.Requests" />
  </ItemGroup>
  <!-- The check entry of this block: the engine checks it with this definition when a checked block uses it. -->
  <ItemGroup>
    <AssemblyMetadata Include="Umpire.Architecture" Value="Umpire.Kernels.MessagesArchitecture, Umpire.Kernels.Definition" />
    <AssemblyMetadata Include="Umpire.Root" Value=".." />
  </ItemGroup>
</Project>
