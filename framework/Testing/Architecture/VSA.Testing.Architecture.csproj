<Project Sdk="Microsoft.NET.Sdk">
  <!-- The VSA architecture tests: the test base with the tests, and the layer extensions for ArchUnitNET rules.
       The VSA definition is in VSA.Architecture.Vsa. The build targets add the test class to each test project that
       references this package. -->
  <ItemGroup>
    <ProjectReference Include="../../Architecture/Engine/VSA.Architecture.Engine.csproj" />
    <ProjectReference Include="../../Architecture/Vsa/VSA.Architecture.Vsa.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="build/*.targets" Pack="true" PackagePath="build/" />
  </ItemGroup>
</Project>
