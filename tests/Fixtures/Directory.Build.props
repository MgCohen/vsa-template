<Project>
  <!-- Referenced fixtures build against the framework source, as the samples do.
       This file does not import tests/Directory.Build.props: a fixture is not a test project. -->
  <Import Project="$(MSBuildThisFileDirectory)../../Directory.Build.props" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UmpireFrameworkSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</UmpireFrameworkSourceDir>
  </PropertyGroup>
  <!-- This repository has one global.json and more than one app. Each folder here is one app, so it is the app root of its projects.
       A consumer app has its own global.json, so it does not set UmpireAppRoot. -->
  <PropertyGroup>
    <_UmpireDevApp>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/'))/</_UmpireDevApp>
    <UmpireAppRoot>$(MSBuildThisFileDirectory)$(_UmpireDevApp.Substring(0, $(_UmpireDevApp.IndexOf('/'))))/</UmpireAppRoot>
    <ArtifactsPath>$(UmpireAppRoot)artifacts~</ArtifactsPath>
  </PropertyGroup>
</Project>
