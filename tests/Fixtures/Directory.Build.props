<Project>
  <!-- The fixtures build against the framework source in this repository (source mode, Umpire.SourceMode.props).
       This file does not import tests/Directory.Build.props: a fixture is not a test project. -->
  <Import Project="$(MSBuildThisFileDirectory)../../Directory.Build.props" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UmpireFrameworkSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</UmpireFrameworkSourceDir>
    <!-- Some fixtures break the rules on purpose, and the tests run the engine on the others. So a fixture build does not check. -->
    <UmpireCheck>false</UmpireCheck>
  </PropertyGroup>
  <!-- This repository has one global.json and more than one app. Each folder here is one app, so it is the block folder of its projects.
       A consumer app has its own global.json, so it does not set UmpireBlock. -->
  <PropertyGroup>
    <_UmpireDevApp>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/'))/</_UmpireDevApp>
    <UmpireBlock>$(MSBuildThisFileDirectory)$(_UmpireDevApp.Substring(0, $(_UmpireDevApp.IndexOf('/'))))/</UmpireBlock>
    <ArtifactsPath>$(UmpireBlock)artifacts~</ArtifactsPath>
  </PropertyGroup>
  <Import Project="$(UmpireFrameworkSourceDir)tools/bundle/SourceMode/Umpire.SourceMode.props" />
</Project>
