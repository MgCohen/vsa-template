<Project Sdk="Microsoft.NET.Sdk">
  <!-- The MVVM app of the "Hello MVVM" guide, with its own definition (Engine/Architecture/MvvmDefinition.cs).
       App/View/GreetingView uses the model Greeting directly, which the definition denies. The viewer loop tests use it.
       The fixture is not in VSA.slnx, so a solution build can build it in Debug when the tests are in Release.
       The output folder has no configuration, so the tests find it in each case. -->
  <PropertyGroup>
    <OutputPath>bin/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(VsaFrameworkSourceDir)Engine/Definition/VSA.Architecture.csproj" />
  </ItemGroup>
</Project>
