<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the checks: the analyzers with the Roslyn analyzer test library, the formatting build of VSA.Sdk and the unit test base.
       The architecture engine has its own tests in tests/Architecture.Tests. NUnit comes from tests/Directory.Build.props. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <!-- The test library asks for old versions. These are the versions that VSA.Analyzers uses, and a version with no known vulnerability. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)tests/Shared/Tests.Shared.csproj" />
    <ProjectReference Include="$(RepoRoot)framework/Architectures/Vsa/Rules/VSA.Analyzers.csproj" />
    <ProjectReference Include="$(RepoRoot)framework/Kernel/Analyzers/VSA.Kernel.Analyzers.csproj" />
    <ProjectReference Include="$(RepoRoot)framework/Architectures/Vsa/Testing/VSA.Testing.Unit.csproj" />
    <!-- The analyzer tests compile code against these assemblies. -->
    <ProjectReference Include="$(RepoRoot)framework/Architectures/Vsa/Handlers/Events/VSA.Handlers.Events.csproj" />
    <ProjectReference Include="$(RepoRoot)framework/Architectures/Vsa/Presenters/VSA.Presenters.csproj" />
    <!-- The fixture module of the unit test base (UnitBaseTests). -->
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Rules/Features/*/*.csproj" />
    <!-- A fixture app with commands and Domain.Shared projects (UnitBaseCommandTests). -->
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/CommandApp/Features/*/*.csproj" />
  </ItemGroup>
</Project>
