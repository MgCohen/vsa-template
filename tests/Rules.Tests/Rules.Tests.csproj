<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the checks: the analyzers with the Roslyn analyzer test library, the formatting build of Umpire.Sdk and the unit test base.
       The architecture engine has its own tests in tests/Architecture.Tests. NUnit comes from tests/Directory.Build.props. -->
  <PropertyGroup>
    <!-- NoDefaultAnalyzer is a test analyzer: it runs only in the test library, not in a compiler. -->
    <NoWarn>$(NoWarn);RS1036;RS1038;RS1041</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <!-- The test library asks for old versions. These are the versions that Umpire.Vsa.Analyzers uses, and a version with no known vulnerability. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)tests/Shared/Tests.Shared.csproj" />
    <ProjectReference Include="$(RepoRoot)packs/Vsa/Tests/Analyzers/Umpire.Vsa.Analyzers.csproj" />
    <ProjectReference Include="$(RepoRoot)framework/Kernel/Analyzers/Umpire.Kernels.Analyzers.csproj" />
    <ProjectReference Include="$(RepoRoot)packs/Vsa/Tests/Unit/Umpire.Vsa.Testing.Unit.csproj" />
    <!-- The analyzer tests compile code against these assemblies. -->
    <ProjectReference Include="$(RepoRoot)packs/Vsa/Kernel/Handlers/Events/Umpire.Vsa.Handlers.Events.csproj" />
    <ProjectReference Include="$(RepoRoot)packs/Vsa/Kernel/Handlers/Commands/Umpire.Vsa.Handlers.Commands.csproj" />
    <ProjectReference Include="$(RepoRoot)packs/Vsa/Kernel/Presenters/Umpire.Vsa.Presenters.csproj" />
    <!-- The fixture module of the unit test base (UnitBaseTests). -->
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Good/Good.csproj" />
    <!-- A fixture app with commands and Domain.Shared projects (UnitBaseCommandTests). -->
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Battle/Battle.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Cards/Cards.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Resources/Resources.csproj" />
  </ItemGroup>
</Project>
