       whose assemblies are in the test output. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)tests/Shared/Tests.Shared.csproj" />
    <ProjectReference Include="$(RepoRoot)engine/Engine.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Notes/Notes.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/TwoApps/TwoApps.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Blocks/Blocks.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/NoConstructorApp/NoConstructorApp.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/PackVariant/PackVariant.csproj" />
  </ItemGroup>
</Project>
