<Project>
  <!-- Gives the state folder of the check model to the analyzer entry of the engine in the compile of one fixture project. The fixture
       has the analyzer entry from source mode. A finding on data that can be old is a warning, also in a project with
       TreatWarningsAsErrors. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../../tools/bundle/Umpire/build/Umpire.Codes.props" />
  <ItemGroup>
    <CompilerVisibleProperty Include="UmpireCheckState;UmpireCheckMode;ProjectDir;DesignTimeBuild" />
  </ItemGroup>
</Project>
