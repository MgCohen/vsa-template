<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)framework/Kernel/Hosts/Web/Umpire.Hosts.Web.csproj" />
    <ProjectReference Include="$(RepoRoot)packs/Vsa/Kernel/Views/Umpire.Vsa.Views.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Plugins/Toolbox/Toolbox.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Bare/Bare.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Shelf/Shelf.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Twin/Twin.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Signals/Signals.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Echo/Echo.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Answers/Answers.csproj" />
    <!-- Three modules that send commands to each other (CommandTests). -->
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Battle/Battle.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Cards/Cards.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Resources/Resources.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Gauges/Gauges.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Modules/App/Features/Cached/Cached.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Shared/Tests.Shared.csproj" />
    <ProjectReference Include="$(RepoRoot)framework/Components/Config/Umpire.Config.csproj" />
    <ProjectReference Include="$(RepoRoot)packs/Vsa/Definition/Umpire.Vsa.csproj" />
  </ItemGroup>
  <!-- The Unity tests read the netstandard2.0 DLLs of the portable projects and the analyzer DLLs, so these builds come first. -->
  <ItemGroup>
    <PortableProject Include="$(RepoRoot)architecture/Umpire.Architecture.csproj" />
    <PortableProject Include="$(RepoRoot)framework/Kernel/Umpire.Kernels.csproj" />
    <PortableProject Include="$(RepoRoot)framework/Kernel/Definition/Umpire.Kernels.Definition.csproj" />
    <PortableProject Include="$(RepoRoot)framework/Components/Config/Umpire.Config.csproj" />
    <PortableProject Include="$(RepoRoot)framework/Components/Messages/Contracts/Umpire.Messages.Contracts.csproj" />
    <PortableProject Include="$(RepoRoot)packs/Vsa/Definition/Umpire.Vsa.csproj" />
    <PortableProject Include="$(RepoRoot)packs/Vsa/Kernel/Composition/Umpire.Vsa.Composition.csproj" />
    <PortableProject Include="$(RepoRoot)packs/Vsa/Kernel/Contracts/Commands/Umpire.Vsa.Contracts.Commands.csproj" />
    <PortableProject Include="$(RepoRoot)packs/Vsa/Kernel/Contracts/Events/Umpire.Vsa.Contracts.Events.csproj" />
    <PortableProject Include="$(RepoRoot)packs/Vsa/Kernel/Contracts/Requests/Umpire.Vsa.Contracts.Requests.csproj" />
    <PortableProject Include="$(RepoRoot)packs/Vsa/Kernel/Domain/Umpire.Vsa.Domain.csproj" />
    <PortableProject Include="$(RepoRoot)packs/Vsa/Kernel/Handlers/Commands/Umpire.Vsa.Handlers.Commands.csproj" />
    <PortableProject Include="$(RepoRoot)packs/Vsa/Kernel/Handlers/Events/Umpire.Vsa.Handlers.Events.csproj" />
    <PortableProject Include="$(RepoRoot)packs/Vsa/Kernel/Handlers/Requests/Umpire.Vsa.Handlers.Requests.csproj" />
    <PortableProject Include="$(RepoRoot)packs/Vsa/Kernel/Infrastructure/Umpire.Vsa.Infrastructure.csproj" />
    <PortableProject Include="$(RepoRoot)packs/Vsa/Kernel/Presenters/Umpire.Vsa.Presenters.csproj" />
    <PortableProject Include="$(RepoRoot)tools/bundle/Umpire/Umpire.csproj" />
    <PortableProject Include="$(RepoRoot)tools/bundle/Vsa/Umpire.Vsa.Kernel.csproj" />
    <PortableProject Include="$(RepoRoot)tools/bundle/Definition/Umpire.Definition.csproj" />
    <PortableProject Include="$(RepoRoot)tools/bundle/VsaDefinition/Umpire.Vsa.Definition.csproj" />
    <ProjectReference Include="@(PortableProject)" Exclude="@(ProjectReference)" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)architecture/Markers/Umpire.Markers.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- The evaluated target frameworks of each portable project, for PortableTargetTests. Old build folders in artifacts~ do not change them. -->
  <Target Name="_WritePortableFrameworks" AfterTargets="ResolveProjectReferences">
    <MSBuild Projects="@(PortableProject)" Targets="GetTargetFrameworks" BuildInParallel="true" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_PortableFramework" />
    </MSBuild>
    <WriteLinesToFile File="$(OutDir)portable-frameworks.txt" Lines="@(_PortableFramework->'%(Filename)=%(TargetFrameworks)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(OutDir)portable-frameworks.txt" />
    </ItemGroup>
  </Target>
</Project>
