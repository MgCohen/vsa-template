<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the rule answers (the queries of the engine, engine/App/Plugins/Facts/Domain/Shared/Queries) and the Rules step of the engine on the fixture apps in tests/Fixtures/Architecture,
       with a small test definition, and the pack variant of tests/Fixtures/PackVariant. -->
  <PropertyGroup>
    <RootNamespace>EngineCore.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)engine/Engine.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Shared/Tests.Shared.csproj" />
    <ProjectReference Include="$(RepoRoot)packs/Vsa/Tests/Unit/Umpire.Vsa.Testing.Unit.csproj" Aliases="testing" />
    <ProjectReference Include="$(RepoRoot)packs/Vsa/Definition/Umpire.Vsa.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/Architecture/*/*.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/PackVariant/PackVariant.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/Fixtures/PackVariant/App/Packs/Ecs/Definition/Ecs.Definition.csproj" />
  </ItemGroup>
</Project>
