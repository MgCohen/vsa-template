<Project Sdk="Microsoft.NET.Sdk">
  <!-- The umpire tool. It ships as a .NET tool with the same version as the Umpire packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Umpire.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <!-- The tool targets net8.0. If .NET 8 is not installed, it runs on the newest runtime, for example the runtime of the .NET 10 SDK. -->
    <RollForward>Major</RollForward>
    <ToolCommandName>umpire</ToolCommandName>
    <PackageId>Umpire.Cli</PackageId>
    <!-- Templates/ is a separate app that builds on its own. The tool holds its files as resources. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Templates/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cli.Tests" />
  </ItemGroup>
  <!-- The test project of a new app gives the NUnit versions of this repository. -->
  <ItemGroup>
    <AssemblyMetadata Include="UmpireNUnitVersion" Value="@(PackageVersion->WithMetadataValue('Identity', 'NUnit')->'%(Version)')" />
    <AssemblyMetadata Include="UmpireNUnitAdapterVersion" Value="@(PackageVersion->WithMetadataValue('Identity', 'NUnit3TestAdapter')->'%(Version)')" />
  </ItemGroup>
  <!-- The tool is an app: UmpireTool is App<ToolKernel, ToolHost>, and ToolHost is a ConsoleHost. The kernel gives one
       operation for each command, and the host converts the command line of the tool into the words of that operation. -->
  <ItemGroup>
    <ProjectReference Include="../../framework/Kernel/Hosts/Console/Umpire.Hosts.Console.csproj" />
    <ProjectReference Include="../../engine/Versions/Umpire.Engine.Versions.csproj" />
    <ProjectReference Include="../Files/Umpire.Files.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Templates/**" Exclude="Templates/*.props;Templates/**/artifacts~/**;Templates/**/bin/**;Templates/**/obj/**;Templates/**/*.user;Templates/**/*.db;Templates/**/*.db-shm;Templates/**/*.db-wal"
                      LogicalName="Templates/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
