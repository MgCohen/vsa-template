<Project>
  <!-- Takes the place of Sdk="Umpire.Sdk" inside this repository, so the engine, the fixtures and the templates use the SDK files from source.
       A consumer project is only <Project Sdk="Umpire.Sdk" />. -->
  <!-- The apps of this repository (the engine, the fixtures and the templates) also check the recommended .NET rules.
       The framework projects use the default analysis level. -->
  <PropertyGroup>
    <AnalysisLevel Condition="'$(AnalysisLevel)' == ''">latest-recommended</AnalysisLevel>
    <UmpireSdkDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'Sdk'))</UmpireSdkDir>
  </PropertyGroup>
  <!-- The NUnit versions of a test project come from Directory.Packages.props of this repository, as in the package. -->
  <PropertyGroup>
    <_UmpireRepoPackages>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../Directory.Packages.props'))</_UmpireRepoPackages>
    <UmpireNUnitVersion Condition="'$(UmpireNUnitVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_UmpireRepoPackages)', '(?s).*Include=&quot;NUnit&quot; Version=&quot;([^&quot;]+)&quot;.*', '$1'))</UmpireNUnitVersion>
    <UmpireNUnitAdapterVersion Condition="'$(UmpireNUnitAdapterVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_UmpireRepoPackages)', '(?s).*Include=&quot;NUnit3TestAdapter&quot; Version=&quot;([^&quot;]+)&quot;.*', '$1'))</UmpireNUnitAdapterVersion>
  </PropertyGroup>
  <Import Project="$(UmpireSdkDir)Sdk.props" />
</Project>
