<Project>
  <!-- Umpire.Sdk.Web: Umpire.Sdk on Microsoft.NET.Sdk.Web. A web app is one line: <Project Sdk="Umpire.Sdk.Web/<version>" />.
       The package holds the files of Umpire.Sdk next to this file. -->
  <Import Project="$(MSBuildThisFileDirectory)Umpire.Sdk.Output.props" />
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Web" />
  <Import Project="$(MSBuildThisFileDirectory)Umpire.Sdk.Core.props" />
</Project>
