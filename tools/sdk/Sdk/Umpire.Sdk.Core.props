<Project>
  <!-- The Umpire part of Umpire.Sdk and Umpire.Sdk.Web, after the props of the platform SDK. -->
  <Import Project="$(MSBuildThisFileDirectory)Umpire.Version.props" Condition="Exists('$(MSBuildThisFileDirectory)Umpire.Version.props')" />
  <!-- In the Umpire repository, the root Directory.Build.props imports the general settings first. -->
  <Import Project="$(MSBuildThisFileDirectory)Umpire.Common.props" Condition="'$(_UmpireCommonImported)' != 'true'" />

  <PropertyGroup>
    <UsingUmpireSdk>true</UsingUmpireSdk>
  </PropertyGroup>

  <!-- A definition project copies the DLLs of its packages to its output, so the root project can give them to the check. -->
  <PropertyGroup Condition="'$([System.IO.Path]::GetFileName($(MSBuildProjectDirectory)))' == 'definition'">
    <CopyLocalLockFileAssemblies Condition="'$(CopyLocalLockFileAssemblies)' == ''">true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- A project whose name ends with ".Tests" is a test project: NUnit on Microsoft.Testing.Platform (Umpire.Sdk.Core.targets).
       The platform SDK reads OutputType before the project body, so UmpireTestProject=false goes in a Directory.Build.props file. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <UmpireTestProject Condition="'$(UmpireTestProject)' == ''">true</UmpireTestProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmpireTestProject)' == 'true'">
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
  </PropertyGroup>
</Project>
