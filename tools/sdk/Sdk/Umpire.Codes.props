<Project>
  <!-- The one list of the Umpire codes. A finding is a warning by default, so TreatWarningsAsErrors and -warnaserror do not make
       it an error. A code in WarningsAsErrors of the project stays an error. The compiler gets the list only with
       TreatWarningsAsErrors, because its WarningsNotAsErrors wins over an .editorconfig severity. A pack with its own codes adds them to UmpireCodes.
       Tests compare this list with the codes of the analyzers, the rule engine and the check model. -->
  <PropertyGroup>
    <UmpireCodes>$(UmpireCodes);
      UMP010001;UMP010002;UMP010003;
      UMP010101;UMP010102;UMP010103;UMP010104;UMP010105;UMP010106;UMP010107;
      UMP010201;UMP010206;
      UMP020101;UMP020102;
      UMP020201;UMP020202;UMP020204;UMP020205;UMP020206;
      UMP020301;UMP020302;UMP020303;UMP020304;
      UMP020401;UMP020402;
      UMP030001;UMP030002;UMP030003;UMP030004;
      UMP030101;
      UMP030201;UMP030202;
      UMP030301;UMP030302;UMP030303;UMP030304;UMP030305;UMP030306;UMP030307;UMP030308;
      UMP030401;
      UMP030501;UMP030502;UMP030503;UMP030505;UMP030506;UMP030507;UMP030508;UMP030509;UMP030510;UMP030511;UMP030512;UMP030513;
      UMP030801;UMP030802;UMP030803;UMP030804;UMP030805
    </UmpireCodes>
    <UmpireCodes>$([System.Text.RegularExpressions.Regex]::Replace('$(UmpireCodes)', '[^A-Za-z0-9;]', '').Trim(';'))</UmpireCodes>
    <_UmpireWarningCodes>$(UmpireCodes)</_UmpireWarningCodes>
    <_UmpireErrorCodes>$([System.Text.RegularExpressions.Regex]::Replace('$(WarningsAsErrors);$(MSBuildWarningsAsErrors)', '[^A-Za-z0-9]+', '|').Trim('|'))</_UmpireErrorCodes>
    <_UmpireWarningCodes Condition="'$(_UmpireErrorCodes)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(UmpireCodes)', '(?i)(^|;)($(_UmpireErrorCodes))(?=;|$)', ''))</_UmpireWarningCodes>
    <WarningsNotAsErrors Condition="'$(TreatWarningsAsErrors)' == 'true'">$(WarningsNotAsErrors);$(_UmpireWarningCodes)</WarningsNotAsErrors>
    <MSBuildWarningsNotAsErrors>$(MSBuildWarningsNotAsErrors);$(_UmpireWarningCodes)</MSBuildWarningsNotAsErrors>
  </PropertyGroup>
</Project>
