<Project>
  <!-- The general build settings of each Umpire project. The root Directory.Build.props of the Umpire repository also imports it. -->
  <PropertyGroup>
    <_UmpireCommonImported>true</_UmpireCommonImported>
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
