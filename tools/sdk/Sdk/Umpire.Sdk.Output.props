<Project>
  <!-- The block root is the folder of the nearest .umpireconfig file at or above the project. With no .umpireconfig file,
       it is the project folder. The build output of each project in the block goes to one artifacts~ folder in the block root,
       in the .NET artifacts layout (one folder for each project name). The rule engine and umpire init do not read a folder
       whose name ends with ~. Set ArtifactsPath to use another folder.
       This file comes before the props of the platform SDK, because they set the output folders. A value that a
       Directory.Build.props file sets wins. -->
  <PropertyGroup>
    <UmpireConfigFile Condition="'$(UmpireConfigFile)' == ''">$([MSBuild]::GetPathOfFileAbove('.umpireconfig', '$(MSBuildProjectDirectory)'))</UmpireConfigFile>
    <_UmpireBlockRoot Condition="'$(UmpireConfigFile)' != ''">$([System.IO.Path]::GetDirectoryName('$(UmpireConfigFile)'))</_UmpireBlockRoot>
    <_UmpireBlockRoot Condition="'$(_UmpireBlockRoot)' == ''">$(MSBuildProjectDirectory)</_UmpireBlockRoot>
    <UseArtifactsOutput Condition="'$(UseArtifactsOutput)' == ''">true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$([MSBuild]::NormalizeDirectory('$(_UmpireBlockRoot)', 'artifacts~'))</ArtifactsPath>
  </PropertyGroup>
</Project>
