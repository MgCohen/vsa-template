<Project>
  <!-- The Umpire part of Umpire.Sdk and Umpire.Sdk.Web, after the targets of the platform SDK. -->
  <!-- An app has one root project in the app root. It compiles each file in its folder tree. A nested project is optional,
       for example a test project or a separate assembly. The parent project does not compile the files of a nested project,
       so no file compiles two times. The build output of each project (bin/, obj/) and the folders in UmpireExcludedFolders
       (for example Assets/ of a Unity project) are not source folders. -->
  <PropertyGroup>
    <UmpireExcludedFolders Condition="'$(UmpireExcludedFolders)' == ''">Assets;Library;Temp;Logs;UserSettings;node_modules</UmpireExcludedFolders>
    <_UmpireNotSource>**/bin/**;**/obj/**;$([MSBuild]::Unescape($(UmpireExcludedFolders.Replace(';', '/**;'))))/**</_UmpireNotSource>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(_UmpireNotSource)</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <_UmpireNestedProject Include="**/*.csproj" Exclude="$(MSBuildProjectFile);$(_UmpireNotSource)" />
    <Compile Remove="@(_UmpireNestedProject->'%(RelativeDir)**')" />
    <Content Remove="@(_UmpireNestedProject->'%(RelativeDir)**')" />
    <None Remove="@(_UmpireNestedProject->'%(RelativeDir)**')" />
    <EmbeddedResource Remove="@(_UmpireNestedProject->'%(RelativeDir)**')" />
  </ItemGroup>

  <!-- The general packages that each app needs, with no layer, and the default pack.
       Path is the project folder under the repository root in source mode. An Analyzer item is a Roslyn analyzer, not a library. -->
  <ItemDefinitionGroup>
    <_UmpireFramework>
      <Analyzer>false</Analyzer>
    </_UmpireFramework>
  </ItemDefinitionGroup>
  <ItemGroup>
    <_UmpireFramework Include="Umpire.Kernels" Path="framework/Kernel" />
    <_UmpireFramework Include="Umpire.Markers" Path="architecture/Markers" />
    <!-- Pinned choice (W24): in package mode, the analyzer package of the pack holds the kernel analyzer (Umpire.KernelBundle.targets). -->
    <_UmpireFramework Include="Umpire.Kernels.Analyzers" Path="framework/Kernel/Analyzers" Analyzer="true" Condition="'$(UmpireFrameworkSourceDir)' != ''" />
  </ItemGroup>
  <!-- The code of the app selects its pack (App<Vsa<...>>). A package only makes a pack available. The SDK adds the default pack,
       VSA, and its test bases for a test project. UmpireDefaultPack=false leaves them out: then the app references the package
       of its pack and of its test bases itself. A pack package brings its analyzers. Source mode adds them here, because a
       project reference does not bring analyzers. -->
  <PropertyGroup>
    <UmpireDefaultPack Condition="'$(UmpireDefaultPack)' == ''">true</UmpireDefaultPack>
  </PropertyGroup>
  <ItemGroup Condition="'$(UmpireDefaultPack)' == 'true'">
    <_UmpireFramework Include="Umpire.Vsa" Path="packs/Vsa/Architecture" />
    <_UmpireFramework Include="Umpire.Vsa.Analyzers" Path="packs/Vsa/Tests/Analyzers" Analyzer="true" Condition="'$(UmpireFrameworkSourceDir)' != ''" />
    <_UmpireTestBase Include="Umpire.Vsa.Testing.Unit" Path="packs/Vsa/Tests/Unit" />
  </ItemGroup>

  <!-- Source mode (this repository): project references into the framework source, when UmpireFrameworkSourceDir is set. -->
  <ItemGroup Condition="'$(UmpireFrameworkSourceDir)' != ''">
    <ProjectReference Include="@(_UmpireFramework->WithMetadataValue('Analyzer', 'false')->'$(UmpireFrameworkSourceDir)%(Path)/%(Identity).csproj')" />
    <ProjectReference Include="@(_UmpireFramework->WithMetadataValue('Analyzer', 'true')->'$(UmpireFrameworkSourceDir)%(Path)/%(Identity).csproj')"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- Package mode (consumers): package references with the version of this SDK.
       With central package management, a PackageReference cannot set Version, so it gets VersionOverride.
       A Umpire.* package that the project adds itself, for example a web host of the pack, gives its own version. The rule engine checks it (UMP030401). -->
  <PropertyGroup Condition="'$(UmpireFrameworkSourceDir)' == ''">
    <_UmpireV Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(UmpireVersion)</_UmpireV>
    <_UmpireVO Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(UmpireVersion)</_UmpireVO>
  </PropertyGroup>
  <ItemGroup Condition="'$(UmpireFrameworkSourceDir)' == ''">
    <PackageReference Include="@(_UmpireFramework->WithMetadataValue('Analyzer', 'false'))" Version="$(_UmpireV)" VersionOverride="$(_UmpireVO)" />
    <PackageReference Include="@(_UmpireFramework->WithMetadataValue('Analyzer', 'true'))" Version="$(_UmpireV)" VersionOverride="$(_UmpireVO)" PrivateAssets="all" />
  </ItemGroup>

  <!-- The root project of the app runs the rule engine: the executable in the block root that is not a test project. A
       nested console project of the same block does not check the block again. UmpireEngine=false turns it off. The engine
       is in this package, in tools/net10.0/ (Umpire.Sdk.Package.targets). -->
  <PropertyGroup Condition="'$(UmpireEngine)' == ''">
    <UmpireEngine>false</UmpireEngine>
    <UmpireEngine Condition="'$(OutputType)' == 'Exe' and '$(UmpireTestProject)' != 'true' and !$(MSBuildProjectName.EndsWith('.Tests')) and '$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory)))' == '$([MSBuild]::NormalizeDirectory($(_UmpireBlockRoot)))'">true</UmpireEngine>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmpireFrameworkSourceDir)' == ''">
    <UmpireEngineFile Condition="'$(UmpireEngineFile)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'tools', 'net10.0', 'umpire-engine.dll'))</UmpireEngineFile>
  </PropertyGroup>

  <!-- Source mode (this repository): the engine is the output of engine/Engine.csproj. The engine checks itself with its own
       new output. Each other root project builds the engine first, with no reference to its assembly, so the engine files
       do not go into its bin. -->
  <PropertyGroup Condition="'$(UmpireFrameworkSourceDir)' != ''">
    <_UmpireEngineProject>$([MSBuild]::NormalizePath('$(UmpireFrameworkSourceDir)', 'engine', 'Engine.csproj'))</_UmpireEngineProject>
    <_UmpireIsEngine Condition="'$(MSBuildProjectFullPath)' == '$(_UmpireEngineProject)'">true</_UmpireIsEngine>
    <UmpireEngineFile Condition="'$(UmpireEngineFile)' == '' and '$(_UmpireIsEngine)' != 'true'">$([MSBuild]::NormalizePath('$(UmpireFrameworkSourceDir)', 'engine', 'artifacts~', 'bin', 'Engine', '$(Configuration.ToLowerInvariant())', 'umpire-engine.dll'))</UmpireEngineFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(UmpireFrameworkSourceDir)' != '' and '$(UmpireEngine)' == 'true' and '$(UmpireCheck)' != 'false' and '$(_UmpireIsEngine)' != 'true'">
    <ProjectReference Include="$(_UmpireEngineProject)" ReferenceOutputAssembly="false" Private="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- The architecture check after each build of the root project. MSBuild only calls the engine with the Check stage: the
       engine reads .umpireconfig (for example umpire.check.mode) and decides what to check. Its Changes step skips the check
       when no input changed. -p:UmpireCheck=false stops the call for one build. -p:UmpireCheckMode=Warn gives the mode for
       one build, and it wins over .umpireconfig. UmpireBlock gives the block folder (this repository has one global.json for
       many apps). -->
  <PropertyGroup>
    <_UmpireDotnet Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_UmpireDotnet>
    <_UmpireDotnet Condition="'$(_UmpireDotnet)' == ''">dotnet</_UmpireDotnet>
  </PropertyGroup>
  <Target Name="UmpireCheck" AfterTargets="Build"
          Condition="'$(UmpireEngine)' == 'true' and '$(UmpireCheck)' != 'false' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <UmpireEngineFile Condition="'$(_UmpireIsEngine)' == 'true'">$(TargetPath)</UmpireEngineFile>
      <_UmpireModeArgument Condition="'$(UmpireCheckMode)' != ''"> --mode $(UmpireCheckMode)</_UmpireModeArgument>
      <_UmpireBlockArgument Condition="'$(UmpireBlock)' != ''"> --block &quot;$(UmpireBlock.TrimEnd('\').TrimEnd('/'))&quot;</_UmpireBlockArgument>
    </PropertyGroup>
    <Error Condition="!Exists('$(UmpireEngineFile)')" Code="UMP030003"
           Text="The rule engine $(UmpireEngineFile) does not exist, so the architecture check cannot run. Restore the project again, so the Umpire SDK package is complete." />
    <!-- A finding line fails the build (Exec reads each canonical error line). An exit code that is not 0 with no error line
         is an engine crash, for example an exception or a missing runtime: it fails the build too, with UMP030004. -->
    <Exec IgnoreExitCode="true" StandardOutputImportance="high" StandardErrorImportance="high" ConsoleToMSBuild="true"
          Command="&quot;$(_UmpireDotnet)&quot; exec &quot;$(UmpireEngineFile)&quot; --stage Check --project &quot;$(MSBuildProjectDirectory.TrimEnd('\').TrimEnd('/'))&quot;$(_UmpireBlockArgument) --bin &quot;$(TargetDir.TrimEnd('\').TrimEnd('/'))&quot;$(_UmpireModeArgument)">
      <Output TaskParameter="ExitCode" PropertyName="_UmpireCheckExit" />
      <Output TaskParameter="ConsoleOutput" ItemName="_UmpireCheckLine" />
    </Exec>
    <PropertyGroup>
      <_UmpireCheckOutput>@(_UmpireCheckLine)</_UmpireCheckOutput>
    </PropertyGroup>
    <Error Condition="'$(_UmpireCheckExit)' != '0' and !$(_UmpireCheckOutput.Contains(': error '))" Code="UMP030004"
           Text="The rule engine stopped with exit code $(_UmpireCheckExit) and reported no finding, so the architecture check did not run. Read the engine output above." />
  </Target>

  <!-- A test project (UmpireTestProject, Umpire.Sdk.Core.props) gets NUnit and the test bases of the pack.
       It references the projects that it tests itself. -->
  <PropertyGroup Condition="'$(UmpireTestProject)' == 'true'">
    <_UmpireNUnitV Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(UmpireNUnitVersion)</_UmpireNUnitV>
    <_UmpireNUnitVO Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(UmpireNUnitVersion)</_UmpireNUnitVO>
    <_UmpireNUnitAdapterV Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(UmpireNUnitAdapterVersion)</_UmpireNUnitAdapterV>
    <_UmpireNUnitAdapterVO Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(UmpireNUnitAdapterVersion)</_UmpireNUnitAdapterVO>
  </PropertyGroup>
  <ItemGroup Condition="'$(UmpireTestProject)' == 'true'">
    <Using Include="NUnit.Framework" />
  </ItemGroup>
  <ItemGroup Condition="'$(UmpireTestProject)' == 'true' and '$(UmpireFrameworkSourceDir)' == ''">
    <PackageReference Include="NUnit" Version="$(_UmpireNUnitV)" VersionOverride="$(_UmpireNUnitVO)" />
    <PackageReference Include="NUnit3TestAdapter" Version="$(_UmpireNUnitAdapterV)" VersionOverride="$(_UmpireNUnitAdapterVO)" />
    <PackageReference Include="@(_UmpireTestBase)" Version="$(_UmpireV)" VersionOverride="$(_UmpireVO)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UmpireTestProject)' == 'true' and '$(UmpireFrameworkSourceDir)' != ''">
    <PackageReference Include="NUnit" Version="$(_UmpireNUnitV)" VersionOverride="$(_UmpireNUnitVO)" />
    <PackageReference Include="NUnit3TestAdapter" Version="$(_UmpireNUnitAdapterV)" VersionOverride="$(_UmpireNUnitAdapterVO)" />
    <ProjectReference Include="@(_UmpireTestBase->'$(UmpireFrameworkSourceDir)%(Path)/%(Identity).csproj')" />
  </ItemGroup>

  <!-- The rule values of the block are in the .umpireconfig file in the block root (UmpireConfigFile, Umpire.Sdk.Output.props).
       The Umpire analyzers read that file with Umpire.Config, so the compiler gets it as an additional file. The defaults
       of each rule are on its class. -->
  <ItemGroup Condition="'$(UmpireConfigFile)' != '' and Exists('$(UmpireConfigFile)')">
    <AdditionalFiles Include="$(UmpireConfigFile)" Visible="false" />
  </ItemGroup>

  <!-- The module settings come from the .umpireconfig file at run time (UmpireConfigSettings), so each executable project
       (the root project and each test project) copies it to its output folder. A library does not, so no package gets it. -->
  <ItemGroup Condition="'$(UmpireConfigFile)' != '' and Exists('$(UmpireConfigFile)') and '$(OutputType)' != 'Library'">
    <None Remove="$(UmpireConfigFile)" />
    <None Include="$(UmpireConfigFile)" Link=".umpireconfig" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- netstandard2.1 does not have the type that the compiler needs for init and records. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Include="$(MSBuildThisFileDirectory)../Polyfills/*.cs" Visible="false" />
  </ItemGroup>

  <!-- EF Core writes the files in Infrastructure/Migrations/, so they are generated code: the style rules do not check them.
       EF does not mark each file as generated, so a global config in obj/ marks each one (generated_code = true). -->
  <Target Name="_UmpireGeneratedMigrations" BeforeTargets="CoreCompile" DependsOnTargets="_UmpireMigrationConfig">
    <ItemGroup>
      <EditorConfigFiles Include="$(_UmpireMigrationConfig)" />
    </ItemGroup>
  </Target>
  <Target Name="_UmpireMigrationConfig">
    <PropertyGroup>
      <_UmpireMigrationConfig>$(IntermediateOutputPath)Umpire.Migrations.globalconfig</_UmpireMigrationConfig>
    </PropertyGroup>
    <ItemGroup>
      <_UmpireMigration Include="@(Compile->'%(FullPath)')" Condition="$([System.String]::Copy('%(Compile.FullPath)').Replace('\', '/').Contains('/Infrastructure/Migrations/'))" />
      <_UmpireMigrationLine Include="is_global = true" />
      <_UmpireMigrationLine Include="@(_UmpireMigration->'[%(FullPath)]%0Agenerated_code = true'->Replace('\', '/'))" />
    </ItemGroup>
    <WriteLinesToFile File="$(_UmpireMigrationConfig)" Lines="@(_UmpireMigrationLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
