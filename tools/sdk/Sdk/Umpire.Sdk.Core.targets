<Project>
  <!-- The Umpire part of Umpire.Sdk and Umpire.Sdk.Web, after the targets of the platform SDK. -->
  <Import Project="$(MSBuildThisFileDirectory)Umpire.Codes.props" />

  <!-- An app has one root project in the app root. It compiles each file in its folder tree. A nested project is optional,
       for example a test project or a separate assembly. The parent project does not compile the files of a nested project,
       so no file compiles two times. The build output of each project (bin/, obj/) and the folders in UmpireExcludedFolders
       (default: node_modules) are not source folders. A host with more folders that are not source sets
       UmpireExcludedFolders in its Directory.Build.props. -->
  <PropertyGroup>
    <UmpireExcludedFolders Condition="'$(UmpireExcludedFolders)' == ''">node_modules</UmpireExcludedFolders>
    <_UmpireNotSource>**/bin/**;**/obj/**;$([MSBuild]::Unescape($(UmpireExcludedFolders.Replace(';', '/**;'))))/**</_UmpireNotSource>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(_UmpireNotSource)</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <_UmpireNestedProject Include="**/*.csproj" Exclude="$(MSBuildProjectFile);$(_UmpireNotSource)" />
  </ItemGroup>
  <!-- The nested folders are removed in two steps, because a Remove of these globs fails at 100 or more items: MSBuild then
       looks up the values of an item transform as literal paths (DictionaryBasedItemRemoveThreshold, issue 209).
       1. An Exclude matches the globs on each path, so _UmpireOwnFile gets the files outside the nested folders.
       2. A Remove of literal paths uses the fast dictionary lookup, so _UmpireNestedFile keeps only the nested files.
       An Exclude of literal paths compares each item with each value, so step 2 is a Remove. -->
  <PropertyGroup>
    <_UmpireNestedFolders>@(_UmpireNestedProject->'%(RelativeDir)**')</_UmpireNestedFolders>
  </PropertyGroup>
  <ItemGroup>
    <_UmpireOwnFile Include="@(Compile);@(Content);@(None);@(EmbeddedResource)" Exclude="$(_UmpireNestedFolders)" />
    <_UmpireNestedFile Include="@(Compile);@(Content);@(None);@(EmbeddedResource)" />
    <_UmpireNestedFile Remove="@(_UmpireOwnFile)" />
    <Compile Remove="@(_UmpireNestedFile)" />
    <Content Remove="@(_UmpireNestedFile)" />
    <None Remove="@(_UmpireNestedFile)" />
    <EmbeddedResource Remove="@(_UmpireNestedFile)" />
  </ItemGroup>

  <!-- A definition is a nested project in a folder Definition/, in its own check-time DLL. The project builds it first and does
       not reference it. The definitions below a nested project that is not a test project belong to that project. The target, the runtime and the
       output folder of this project are not the ones of the definition. The kernel of a pack variant
       (App/Packs/<Name>/Kernel/) is a normal reference. -->
  <ItemGroup Condition="'$(UmpireTestProject)' != 'true'">
    <_UmpireNestedOwner Include="@(_UmpireNestedProject)" Exclude="**/*.Tests.csproj" />
    <_UmpireDefinitionProject Include="**/Definition/*.csproj" Exclude="$(MSBuildProjectFile);$(_UmpireNotSource);@(_UmpireNestedOwner->'%(RelativeDir)**/Definition/*.csproj')" />
    <ProjectReference Include="@(_UmpireDefinitionProject)" ReferenceOutputAssembly="false" Private="false"
                      OutputItemType="_UmpireDefinition" SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained;OutputPath;OutDir;_CommandLineDefinedOutputPath" />
    <ProjectReference Include="App/Packs/*/Kernel/*.csproj" GlobalPropertiesToRemove="OutputPath;OutDir;_CommandLineDefinedOutputPath" />
  </ItemGroup>
  <!-- The architecture check reads the definitions from the folder umpire-definitions of the output, and a publish does not
       copy that folder. It gets each definition DLL, each DLL that only a definition uses, and the definitions of the
       referenced projects. The runtime gives the System, Microsoft.Extensions
       and Microsoft.AspNetCore DLLs. -->
  <Target Name="_UmpireCopyDefinitions" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(UmpireTestProject)' != 'true'">
    <PropertyGroup>
      <_UmpireDefinitionsDir>$([MSBuild]::NormalizeDirectory('$(TargetDir)', 'umpire-definitions'))</_UmpireDefinitionsDir>
      <_UmpireDefinitionSources>@(_UmpireDefinition->'%(RootDir)%(Directory)*.dll;%(RootDir)%(Directory)*.pdb')</_UmpireDefinitionSources>
      <_UmpireDefinitionList>$(IntermediateOutputPath)umpire-definitions.$([MSBuild]::StableStringHash('$(_UmpireDefinitionsDir)').ToString('x8')).list</_UmpireDefinitionList>
      <_UmpireReferencedDefinitions>@(_ResolvedProjectReferencePaths->'%(RootDir)%(Directory)umpire-definitions/*')</_UmpireReferencedDefinitions>
      <_UmpirePackDefinitionSources Condition="'$(UmpireFrameworkSourceDir)' != ''">@(_UmpirePackDefinitionOutput->'%(RootDir)%(Directory)*.dll;%(RootDir)%(Directory)*.pdb')</_UmpirePackDefinitionSources>
      <_UmpirePackDefinitionSources Condition="'$(UmpireFrameworkSourceDir)' == '' and '@(_UmpirePackDefinition)' != ''">$(_UmpireSdkEngineDir)Umpire.Definition.dll;@(_UmpirePackDefinition->'$(_UmpireSdkEngineDir)%(Package).dll')</_UmpirePackDefinitionSources>
    </PropertyGroup>
    <!-- Many projects can have one output folder (-o), so a project deletes only the files that it copied to this folder before. -->
    <ReadLinesFromFile File="$(_UmpireDefinitionList)" Condition="Exists('$(_UmpireDefinitionList)')">
      <Output TaskParameter="Lines" ItemName="_UmpireDefinitionBefore" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_UmpireDefinitionCandidate Include="$(_UmpireDefinitionSources);$(_UmpireReferencedDefinitions)" Exclude="$(_UmpireDefinitionsDir)*" />
      <_UmpireDefinitionName Include="@(_UmpireDefinitionCandidate->'%(Filename)%(Extension)')" Source="%(FullPath)"
                             Condition="!$([System.String]::Copy('%(Filename)').StartsWith('System.')) and !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Extensions.')) and !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.AspNetCore.'))" />
      <_UmpirePackDefinitionCandidate Include="$(_UmpirePackDefinitionSources)" />
      <_UmpirePackDefinitionName Include="@(_UmpirePackDefinitionCandidate->'%(Filename)%(Extension)')" Source="%(FullPath)"
                                 Condition="!$([System.String]::Copy('%(Filename)').StartsWith('System.')) and !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Extensions.')) and !$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.AspNetCore.'))" />
      <_UmpirePackDefinitionName Remove="@(_UmpireDefinitionName)" />
      <_UmpireDefinitionName Include="@(_UmpirePackDefinitionName)" />
      <_UmpireDefinitionName Remove="@(ReferenceCopyLocalPaths->'%(Filename)%(Extension)');$(TargetFileName);$(TargetName).pdb" />
      <_UmpireDefinitionFile Include="@(_UmpireDefinitionName->'%(Source)'->Distinct())" />
      <_UmpireDefinitionCopy Include="@(_UmpireDefinitionFile->'$(_UmpireDefinitionsDir)%(Filename)%(Extension)')" />
      <_UmpireStaleDefinition Include="@(_UmpireDefinitionBefore)" Exclude="@(_UmpireDefinitionCopy)" />
    </ItemGroup>
    <Delete Files="@(_UmpireStaleDefinition)" />
    <Copy SourceFiles="@(_UmpireDefinitionFile)" DestinationFolder="$(_UmpireDefinitionsDir)" SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
    <WriteLinesToFile File="$(_UmpireDefinitionList)" Lines="@(_UmpireDefinitionCopy)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_UmpireDefinitionList)" />
    </ItemGroup>
  </Target>

  <!-- The general parts that each app needs, with no layer, and the default pack.
       Path is the project folder under the repository root in source mode. Package is the bundle package that ships the project
       in package mode (tools/bundle/): many projects share one package. An Analyzer item is a Roslyn analyzer, not a library.
       Only a definition project (UmpireDefinitionProject) gets the definition packages, as private assets, so they do not
       flow to the runtime. A test project gets the definition API also with no default pack. -->
  <ItemDefinitionGroup>
    <_UmpireFramework>
      <Analyzer>false</Analyzer>
    </_UmpireFramework>
  </ItemDefinitionGroup>
  <ItemGroup>
    <_UmpireFramework Include="Umpire.Kernels" Path="framework/Kernel" Package="Umpire" Bundle="tools/bundle/Umpire" />
    <_UmpireFramework Include="Umpire.Markers" Path="architecture/Markers" Package="Umpire" Bundle="tools/bundle/Umpire" />
    <_UmpireFramework Include="Umpire.Kernels.Definition" Path="framework/Kernel/Definition" Package="Umpire.Definition" Bundle="tools/bundle/Definition"
                      PrivateAssets="all" Condition="'$(UmpireDefinitionProject)' == 'true'" />
    <_UmpireTestBase Include="Umpire.Kernels.Definition" Path="framework/Kernel/Definition" Package="Umpire.Definition" Bundle="tools/bundle/Definition" />
    <!-- Pinned choice (W24): in package mode, the analyzer package of the pack holds the kernel analyzer (Umpire.KernelBundle.targets). -->
    <_UmpireFramework Include="Umpire.Kernels.Analyzers" Path="framework/Kernel/Analyzers" Analyzer="true" Condition="'$(UmpireFrameworkSourceDir)' != ''" />
  </ItemGroup>
  <!-- The kernel of the app selects its pack (App<VsaKernel, ...>). A package only makes a pack available. The SDK adds the default pack,
       VSA, and its test bases for a test project. UmpireDefaultPack=false leaves them out: then the app references the package
       of its pack and of its test bases itself. A pack package brings its analyzers. Source mode adds them here, because a
       project reference does not bring analyzers. -->
  <PropertyGroup>
    <UmpireDefaultPack Condition="'$(UmpireDefaultPack)' == ''">true</UmpireDefaultPack>
    <!-- A web project (Umpire.Sdk.Web) gets the web host and, with the default pack, its views. UmpireWeb=false leaves them out. -->
    <UmpireWeb Condition="'$(UmpireWeb)' == ''">$(UsingMicrosoftNETSdkWeb)</UmpireWeb>
  </PropertyGroup>
  <ItemGroup Condition="'$(UmpireDefaultPack)' == 'true'">
    <_UmpireFramework Include="Umpire.Vsa.Composition" Path="packs/Vsa/Kernel/Composition" Package="Umpire" Bundle="tools/bundle/Umpire" />
    <_UmpireFramework Include="Umpire.Vsa.Infrastructure" Path="packs/Vsa/Kernel/Infrastructure" Package="Umpire" Bundle="tools/bundle/Umpire" />
    <_UmpireFramework Include="Umpire.Vsa" Path="packs/Vsa/Definition" Package="Umpire.Vsa.Definition" Bundle="tools/bundle/VsaDefinition" PrivateAssets="all" Condition="'$(UmpireDefinitionProject)' == 'true'" />
    <_UmpirePackDefinition Include="Umpire.Vsa" Path="packs/Vsa/Definition" Package="Umpire.Vsa.Definition" Bundle="tools/bundle/VsaDefinition" Condition="'$(UmpireDefinitionProject)' != 'true' and '$(UmpireTestProject)' != 'true'" />
    <_UmpireFramework Include="Umpire.Vsa.Analyzers" Path="packs/Vsa/Tests/Analyzers" Analyzer="true" Condition="'$(UmpireFrameworkSourceDir)' != ''" />
    <_UmpireTestBase Include="Umpire.Vsa.Testing.Unit" Path="packs/Vsa/Tests/Unit" Package="Umpire.Testing" Bundle="tools/bundle/Testing" />
    <_UmpireFramework Include="Umpire.Vsa.Views" Path="packs/Vsa/Kernel/Views" Package="Umpire.Web" Bundle="tools/bundle/Web" Condition="'$(UmpireWeb)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(UmpireWeb)' == 'true'">
    <_UmpireFramework Include="Umpire.Hosts.Web" Path="framework/Kernel/Hosts/Web" Package="Umpire.Web" Bundle="tools/bundle/Web" />
  </ItemGroup>

  <!-- Source mode (this repository): project references into the framework source, when UmpireFrameworkSourceDir is set.
       _UmpireUseBundle=true references the bundle projects (Bundle) in place of the runtime projects, as a consumer gets them.
       The SDK package builds its rule engine so, because the engine must load the definition of an app from the same Umpire.dll.
       It is private: in this repository, the framework blocks have their check entries in the runtime DLLs, so a build of a
       repository app with it gives UMP030001 for each framework block. -->
  <ItemGroup Condition="'$(UmpireFrameworkSourceDir)' != '' and '$(_UmpireUseBundle)' != 'true'">
    <ProjectReference Include="@(_UmpireFramework->WithMetadataValue('Analyzer', 'false')->'$(UmpireFrameworkSourceDir)%(Path)/%(Identity).csproj')" />
  </ItemGroup>
  <ItemGroup Condition="'$(UmpireFrameworkSourceDir)' != '' and '$(_UmpireUseBundle)' == 'true'">
    <ProjectReference Include="@(_UmpireFramework->WithMetadataValue('Analyzer', 'false')->'$(UmpireFrameworkSourceDir)%(Bundle)/%(Package).csproj'->Distinct())" />
  </ItemGroup>
  <ItemGroup Condition="'$(UmpireFrameworkSourceDir)' != ''">
    <ProjectReference Include="@(_UmpireFramework->WithMetadataValue('Analyzer', 'true')->'$(UmpireFrameworkSourceDir)%(Path)/%(Identity).csproj')"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- The definition of the pack is check-time code: a project that is not a definition project and not a test project does
       not compile against it. The architecture check of the app still needs it, so _UmpireCopyDefinitions copies it to the
       folder umpire-definitions. Source mode builds the definition project of the pack first, with no reference to its
       assembly. Package mode takes the DLLs from the engine folder of this SDK package (tools/net8.0/), the same build as the
       definition packages (Package). A project with its own reference to that project keeps it. -->
  <ItemGroup Condition="'$(UmpireFrameworkSourceDir)' != ''">
    <_UmpirePackDefinitionProject Include="@(_UmpirePackDefinition->'$(UmpireFrameworkSourceDir)%(Path)/%(Identity).csproj')" Condition="'$(_UmpireUseBundle)' != 'true'" />
    <_UmpirePackDefinitionProject Include="@(_UmpirePackDefinition->'$(UmpireFrameworkSourceDir)%(Bundle)/%(Package).csproj')" Condition="'$(_UmpireUseBundle)' == 'true'" />
    <_UmpirePackDefinitionProject Remove="@(ProjectReference)" />
    <ProjectReference Include="@(_UmpirePackDefinitionProject)" ReferenceOutputAssembly="false" Private="false"
                      OutputItemType="_UmpirePackDefinitionOutput" SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained;OutputPath;OutDir;_CommandLineDefinedOutputPath" />
  </ItemGroup>
  <PropertyGroup Condition="'$(UmpireFrameworkSourceDir)' == ''">
    <_UmpireSdkEngineDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'tools', 'net8.0'))</_UmpireSdkEngineDir>
  </PropertyGroup>

  <!-- Package mode (consumers): package references with the version of this SDK.
       With central package management, a PackageReference cannot set Version, so it gets VersionOverride.
       A Umpire.* package that the project adds itself, for example a web host of the pack, gives its own version. The rule engine checks it (UMP030401). -->
  <PropertyGroup Condition="'$(UmpireFrameworkSourceDir)' == ''">
    <_UmpireV Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(UmpireVersion)</_UmpireV>
    <_UmpireVO Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(UmpireVersion)</_UmpireVO>
  </PropertyGroup>
  <ItemGroup Condition="'$(UmpireFrameworkSourceDir)' == ''">
    <PackageReference Include="@(_UmpireFramework->WithMetadataValue('Analyzer', 'false')->'%(Package)'->Distinct())" Version="$(_UmpireV)" VersionOverride="$(_UmpireVO)" />
    <PackageReference Include="@(_UmpireFramework->WithMetadataValue('Analyzer', 'true'))" Version="$(_UmpireV)" VersionOverride="$(_UmpireVO)" PrivateAssets="all" />
  </ItemGroup>

  <!-- The root project of the app runs the rule engine: the executable in the block root that is not a test project. A
       nested console project of the same block does not check the block again. UmpireEngine=false turns it off. The engine
       is in this package, in tools/net8.0/ (Umpire.Sdk.Package.targets). -->
  <PropertyGroup Condition="'$(UmpireEngine)' == ''">
    <UmpireEngine>false</UmpireEngine>
    <UmpireEngine Condition="'$(OutputType)' == 'Exe' and '$(UmpireTestProject)' != 'true' and !$(MSBuildProjectName.EndsWith('.Tests')) and '$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory)))' == '$([MSBuild]::NormalizeDirectory($(_UmpireBlockRoot)))'">true</UmpireEngine>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmpireFrameworkSourceDir)' == ''">
    <UmpireEngineFile Condition="'$(UmpireEngineFile)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'tools', 'net8.0', 'umpire-engine.dll'))</UmpireEngineFile>
  </PropertyGroup>

  <!-- Source mode (this repository): the engine is the output of engine/Engine.csproj. The engine checks itself with its own
       new output. Each other root project builds the engine first, with no reference to its assembly, so the engine files
       do not go into its bin. -->
  <PropertyGroup Condition="'$(UmpireFrameworkSourceDir)' != ''">
    <_UmpireEngineProject>$([MSBuild]::NormalizePath('$(UmpireFrameworkSourceDir)', 'engine', 'Engine.csproj'))</_UmpireEngineProject>
    <_UmpireIsEngine Condition="'$(MSBuildProjectFullPath)' == '$(_UmpireEngineProject)'">true</_UmpireIsEngine>
    <UmpireEngineFile Condition="'$(UmpireEngineFile)' == '' and '$(_UmpireIsEngine)' != 'true'">$([MSBuild]::NormalizePath('$(UmpireFrameworkSourceDir)', 'engine', 'artifacts~', 'bin', 'Engine', '$(Configuration.ToLowerInvariant())', 'umpire-engine.dll'))</UmpireEngineFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(UmpireFrameworkSourceDir)' != '' and '$(UmpireEngine)' == 'true' and '$(UmpireCheck)' != 'false' and '$(_UmpireIsEngine)' != 'true'">
    <ProjectReference Include="$(_UmpireEngineProject)" ReferenceOutputAssembly="false" Private="false"
                      SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework" />
  </ItemGroup>

  <!-- The architecture check after each build of the root project. MSBuild only calls the engine with the Check stage: the
       engine reads .umpireconfig (for example umpire.check.mode) and decides what to check. Its Changes step skips the check
       when no input changed. -p:UmpireCheck=false stops the call for one build. A finding is a warning (mode Warn). The key
       umpire.check.mode = "Error" makes it an error. -p:UmpireCheckMode gives the mode for one build, and it wins over the key.
       The hook reads the key itself only for its own codes, UMP030003 and UMP030004. UmpireBlock gives the block folder (this repository has one global.json for
       many apps). -->
  <PropertyGroup>
    <UmpireEngineRollForward Condition="'$(UmpireEngineRollForward)' == ''">LatestMajor</UmpireEngineRollForward>
    <_UmpireDotnet Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_UmpireDotnet>
    <_UmpireDotnet Condition="'$(_UmpireDotnet)' == ''">dotnet</_UmpireDotnet>
  </PropertyGroup>
  <Target Name="UmpireCheck" AfterTargets="Build"
          Condition="'$(UmpireEngine)' == 'true' and '$(UmpireCheck)' != 'false' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <UmpireEngineFile Condition="'$(_UmpireIsEngine)' == 'true'">$(TargetPath)</UmpireEngineFile>
      <_UmpireModeArgument Condition="'$(UmpireCheckMode)' != ''"> --mode $(UmpireCheckMode)</_UmpireModeArgument>
      <_UmpireBlockArgument Condition="'$(UmpireBlock)' != ''"> --block &quot;$(UmpireBlock.TrimEnd('\').TrimEnd('/'))&quot;</_UmpireBlockArgument>
    </PropertyGroup>
    <PropertyGroup Condition="'$(UmpireCheckMode)' != ''">
      <_UmpireHookMode>$(UmpireCheckMode)</_UmpireHookMode>
    </PropertyGroup>
    <PropertyGroup Condition="'$(UmpireCheckMode)' == '' and '$(UmpireConfigFile)' != '' and Exists('$(UmpireConfigFile)')">
      <_UmpireConfigText>$([System.IO.File]::ReadAllText('$(UmpireConfigFile)'))</_UmpireConfigText>
      <_UmpireErrorMode>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_UmpireConfigText)', '(?im)^[ \t]*(umpire[.]check[.]mode|[[][ \t]*umpire[.]check[ \t]*[]](?:(?!^[ \t]*[[])[^$])*?^[ \t]*mode|[[][ \t]*umpire[ \t]*[]](?:(?!^[ \t]*[[])[^$])*?^[ \t]*check[.]mode)[ \t]*=[ \t]*.error.'))</_UmpireErrorMode>
      <_UmpireHookMode Condition="'$(_UmpireErrorMode)' == 'True'">Error</_UmpireHookMode>
    </PropertyGroup>
    <PropertyGroup>
      <_UmpireEngineFound Condition="Exists('$(UmpireEngineFile)')">true</_UmpireEngineFound>
      <_UmpireNoEngine>The rule engine $(UmpireEngineFile) does not exist, so the architecture check did not run.</_UmpireNoEngine>
      <_UmpireNoEngine Condition="'$(UmpireFrameworkSourceDir)' == ''">$(_UmpireNoEngine) Restore the project again, so the Umpire SDK package is complete.</_UmpireNoEngine>
      <_UmpireNoEngine Condition="'$(UmpireFrameworkSourceDir)' != ''">$(_UmpireNoEngine) Build engine/Engine.csproj with the same configuration, or give UmpireEngineFile.</_UmpireNoEngine>
    </PropertyGroup>
    <Error Condition="'$(_UmpireEngineFound)' != 'true' and '$(_UmpireHookMode)' == 'Error'" Code="UMP030003" Text="$(_UmpireNoEngine)" />
    <Warning Condition="'$(_UmpireEngineFound)' != 'true'" Code="UMP030003" Text="$(_UmpireNoEngine)" />
    <!-- Exec reads each canonical error line and warning line, so an error line fails the build and a warning line does not.
         The exit code 1 with a finding line (": error <CODE>: " or ": warning <CODE>: ") is a run with findings. Each other
         exit code that is not 0 is an engine crash, for example an exception or a missing runtime: UMP030004, an error in
         the mode Error, else a warning. The engine targets net8.0 and loads the definition of the
         app, so it runs on the newest installed runtime (LatestMajor): RollForward Major alone selects .NET 8 when it is
         installed, and a net10.0 app does not load there. -->
    <Exec Condition="'$(_UmpireEngineFound)' == 'true'" IgnoreExitCode="true" StandardOutputImportance="high" StandardErrorImportance="high" ConsoleToMSBuild="true"
          Command="&quot;$(_UmpireDotnet)&quot; exec --roll-forward $(UmpireEngineRollForward) &quot;$(UmpireEngineFile)&quot; --stage Check --project &quot;$(MSBuildProjectDirectory.TrimEnd('\').TrimEnd('/'))&quot;$(_UmpireBlockArgument) --bin &quot;$(TargetDir.TrimEnd('\').TrimEnd('/'))&quot;$(_UmpireModeArgument)">
      <Output TaskParameter="ExitCode" PropertyName="_UmpireCheckExit" />
      <Output TaskParameter="ConsoleOutput" ItemName="_UmpireCheckLine" />
    </Exec>
    <PropertyGroup>
      <_UmpireCheckOutput>@(_UmpireCheckLine)</_UmpireCheckOutput>
      <_UmpireCheckFound>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_UmpireCheckOutput)', ': (error|warning) [A-Z]+[0-9]+: '))</_UmpireCheckFound>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_UmpireEngineFound)' == 'true' and '$(_UmpireCheckExit)' != '0' and ('$(_UmpireCheckExit)' != '1' or '$(_UmpireCheckFound)' != 'True')">
      <_UmpireCrash>The rule engine stopped with exit code $(_UmpireCheckExit), so the architecture check did not run to its end. Read the engine output above.</_UmpireCrash>
    </PropertyGroup>
    <Error Condition="'$(_UmpireCrash)' != '' and '$(_UmpireHookMode)' == 'Error'" Code="UMP030004" Text="$(_UmpireCrash)" />
    <Warning Condition="'$(_UmpireCrash)' != '' and '$(_UmpireHookMode)' != 'Error'" Code="UMP030004" Text="$(_UmpireCrash)" />
  </Target>

  <!-- A test project (UmpireTestProject, Umpire.Sdk.Core.props) gets NUnit and the test bases of the pack.
       It references the projects that it tests itself. -->
  <PropertyGroup Condition="'$(UmpireTestProject)' == 'true'">
    <_UmpireNUnitV Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(UmpireNUnitVersion)</_UmpireNUnitV>
    <_UmpireNUnitVO Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(UmpireNUnitVersion)</_UmpireNUnitVO>
    <_UmpireNUnitAdapterV Condition="'$(ManagePackageVersionsCentrally)' != 'true'">$(UmpireNUnitAdapterVersion)</_UmpireNUnitAdapterV>
    <_UmpireNUnitAdapterVO Condition="'$(ManagePackageVersionsCentrally)' == 'true'">$(UmpireNUnitAdapterVersion)</_UmpireNUnitAdapterVO>
  </PropertyGroup>
  <ItemGroup Condition="'$(UmpireTestProject)' == 'true'">
    <Using Include="NUnit.Framework" />
  </ItemGroup>
  <ItemGroup Condition="'$(UmpireTestProject)' == 'true' and '$(UmpireFrameworkSourceDir)' == ''">
    <PackageReference Include="NUnit" Version="$(_UmpireNUnitV)" VersionOverride="$(_UmpireNUnitVO)" />
    <PackageReference Include="NUnit3TestAdapter" Version="$(_UmpireNUnitAdapterV)" VersionOverride="$(_UmpireNUnitAdapterVO)" />
    <PackageReference Include="@(_UmpireTestBase->'%(Package)'->Distinct())" Version="$(_UmpireV)" VersionOverride="$(_UmpireVO)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UmpireTestProject)' == 'true' and '$(UmpireFrameworkSourceDir)' != ''">
    <PackageReference Include="NUnit" Version="$(_UmpireNUnitV)" VersionOverride="$(_UmpireNUnitVO)" />
    <PackageReference Include="NUnit3TestAdapter" Version="$(_UmpireNUnitAdapterV)" VersionOverride="$(_UmpireNUnitAdapterVO)" />
    <ProjectReference Include="@(_UmpireTestBase->'$(UmpireFrameworkSourceDir)%(Path)/%(Identity).csproj')" Condition="'$(_UmpireUseBundle)' != 'true'" />
    <ProjectReference Include="@(_UmpireTestBase->'$(UmpireFrameworkSourceDir)%(Bundle)/%(Package).csproj')" Condition="'$(_UmpireUseBundle)' == 'true'" />
  </ItemGroup>

  <!-- The rule values of the block are in the .umpireconfig file in the block root (UmpireConfigFile, Umpire.Sdk.Output.props).
       The Umpire analyzers read that file with Umpire.Config, so the compiler gets it as an additional file. The defaults
       of each rule are on its class. -->
  <ItemGroup Condition="'$(UmpireConfigFile)' != '' and Exists('$(UmpireConfigFile)')">
    <AdditionalFiles Include="$(UmpireConfigFile)" Visible="false" />
  </ItemGroup>

  <!-- The module settings come from the .umpireconfig file at run time (UmpireConfigSettings), so each executable project
       (the root project and each test project) copies it to its output folder. A library does not, so no package gets it. -->
  <ItemGroup Condition="'$(UmpireConfigFile)' != '' and Exists('$(UmpireConfigFile)') and '$(OutputType)' != 'Library'">
    <None Remove="$(UmpireConfigFile)" />
    <None Include="$(UmpireConfigFile)" Link=".umpireconfig" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- netstandard2.1 does not have the type that the compiler needs for init and records. The folder name ends with ~, so the
       engine does not count the file as a source of the block. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Remove="$(UmpireFrameworkSourceDir)tools/sdk/Polyfills~/*.cs" Condition="'$(UmpireFrameworkSourceDir)' != ''" />
    <Compile Include="$(MSBuildThisFileDirectory)../Polyfills~/*.cs" Visible="false" />
  </ItemGroup>

  <!-- EF Core writes the files in Infrastructure/Migrations/, so they are generated code: the style rules do not check them.
       EF does not mark each file as generated, so a global config in obj/ marks each one (generated_code = true). -->
  <Target Name="_UmpireGeneratedMigrations" BeforeTargets="CoreCompile" DependsOnTargets="_UmpireMigrationConfig">
    <ItemGroup>
      <EditorConfigFiles Include="$(_UmpireMigrationConfig)" />
    </ItemGroup>
  </Target>
  <Target Name="_UmpireMigrationConfig">
    <PropertyGroup>
      <_UmpireMigrationConfig>$(IntermediateOutputPath)Umpire.Migrations.globalconfig</_UmpireMigrationConfig>
    </PropertyGroup>
    <ItemGroup>
      <_UmpireMigration Include="@(Compile->'%(FullPath)')" Condition="$([System.String]::Copy('%(Compile.FullPath)').Replace('\', '/').Contains('/Infrastructure/Migrations/'))" />
      <_UmpireMigrationLine Include="is_global = true" />
      <_UmpireMigrationLine Include="@(_UmpireMigration->'[%(FullPath)]%0Agenerated_code = true'->Replace('\', '/'))" />
    </ItemGroup>
    <WriteLinesToFile File="$(_UmpireMigrationConfig)" Lines="@(_UmpireMigrationLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
