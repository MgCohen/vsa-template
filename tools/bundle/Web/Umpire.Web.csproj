<Project Sdk="Microsoft.NET.Sdk">
  <!-- Umpire.Web.dll: the web host and the views of the VSA pack. A web app references it. The views need the
       VSA kernel, so the package depends on Umpire.Vsa. -->
  <PropertyGroup>
    <Description>The Umpire web host and the views of the VSA pack.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UmpireRoot)framework/Kernel/Hosts/Web/**/*.cs;$(UmpireRoot)packs/Vsa/Kernel/Views/**/*.cs" Exclude="$(_UmpireNotBundled)" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Vsa/Umpire.Vsa.Kernel.csproj" PrivateAssets="none" />
  </ItemGroup>
</Project>
