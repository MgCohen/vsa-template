<Project Sdk="Microsoft.NET.Sdk">
  <!-- Umpire.Web.dll: the web host and the views. Umpire.Sdk.Web adds it to a web app. -->
  <PropertyGroup>
    <Description>The Umpire web host and the views of the VSA pack.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UmpireRoot)framework/Kernel/Hosts/Web/**/*.cs;$(UmpireRoot)packs/Vsa/Kernel/Views/**/*.cs" Exclude="$(_UmpireNotBundled)" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Umpire/Umpire.csproj" />
  </ItemGroup>
</Project>
