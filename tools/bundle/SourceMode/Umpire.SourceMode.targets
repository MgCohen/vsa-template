<Project>
  <!-- Source mode, after Umpire.After.targets: each PackageReference to an Umpire package becomes the project references of
       the source projects of that package. The restore does not see the PackageReference. _UmpireUseBundle=true
       references the bundle projects (tools/bundle/) in place of the runtime projects, as a consumer gets them: the
       package Umpire.Engine builds its rule engine so (Umpire.Engine.csproj). A project reference does not bring analyzers,
       so this file adds the analyzer projects of each package too. -->

  <!-- The units of the Umpire packages. A package holds the units of its dependencies too, as NuGet gives them.
       The package Umpire.Engine has no unit: source mode runs the engine of the source build (Umpire.After.targets). -->
  <ItemGroup>
    <_UmpirePackageUnit Include="Umpire" Unit="Core" />
    <_UmpirePackageUnit Include="Umpire.Vsa" Unit="Core" />
    <_UmpirePackageUnit Include="Umpire.Vsa" Unit="Vsa" />
    <_UmpirePackageUnit Include="Umpire.Web" Unit="Core" />
    <_UmpirePackageUnit Include="Umpire.Web" Unit="Vsa" />
    <_UmpirePackageUnit Include="Umpire.Web" Unit="Web" />
    <_UmpirePackageUnit Include="Umpire.Console" Unit="Core" />
    <_UmpirePackageUnit Include="Umpire.Console" Unit="Console" />
    <_UmpirePackageUnit Include="Umpire.Definition" Unit="Core" />
    <_UmpirePackageUnit Include="Umpire.Definition" Unit="Definition" />
    <_UmpirePackageUnit Include="Umpire.Vsa.Definition" Unit="Core" />
    <_UmpirePackageUnit Include="Umpire.Vsa.Definition" Unit="Vsa" />
    <_UmpirePackageUnit Include="Umpire.Vsa.Definition" Unit="Definition" />
    <_UmpirePackageUnit Include="Umpire.Vsa.Definition" Unit="VsaDefinition" />
    <_UmpirePackageUnit Include="Umpire.Testing" Unit="Core" />
    <_UmpirePackageUnit Include="Umpire.Testing" Unit="Vsa" />
    <_UmpirePackageUnit Include="Umpire.Testing" Unit="Definition" />
    <_UmpirePackageUnit Include="Umpire.Testing" Unit="VsaDefinition" />
    <_UmpirePackageUnit Include="Umpire.Testing" Unit="Testing" />
    <_UmpirePackageUnit Include="Umpire.Engine" Unit="None" />
  </ItemGroup>
  <!-- The source projects of each unit. Source is the runtime project, and Bundle is the bundle project that ships it.
       Kind Analyzer is a Roslyn analyzer. Kind PackDefinition is the check-time definition of a pack (_UmpirePackDefinition). -->
  <ItemGroup>
    <_UmpireUnitPart Include="Core" Kind="Library" Source="framework/Kernel/Umpire.Kernels.csproj" Bundle="tools/bundle/Umpire/Umpire.csproj" />
    <_UmpireUnitPart Include="Core" Kind="Library" Source="architecture/Markers/Umpire.Markers.csproj" Bundle="tools/bundle/Umpire/Umpire.csproj" />
    <_UmpireUnitPart Include="Core" Kind="Analyzer" Source="framework/Kernel/Analyzers/Umpire.Kernels.Analyzers.csproj" />
    <_UmpireUnitPart Include="Vsa" Kind="Library" Source="packs/Vsa/Kernel/Composition/Umpire.Vsa.Composition.csproj" Bundle="tools/bundle/Vsa/Umpire.Vsa.Kernel.csproj" />
    <_UmpireUnitPart Include="Vsa" Kind="Library" Source="packs/Vsa/Kernel/Infrastructure/Umpire.Vsa.Infrastructure.csproj" Bundle="tools/bundle/Vsa/Umpire.Vsa.Kernel.csproj" />
    <_UmpireUnitPart Include="Vsa" Kind="Analyzer" Source="packs/Vsa/Tests/Analyzers/Umpire.Vsa.Analyzers.csproj" />
    <_UmpireUnitPart Include="Vsa" Kind="PackDefinition" PackName="Umpire.Vsa" Package="Umpire.Vsa.Definition" Source="packs/Vsa/Definition/Umpire.Vsa.csproj" Bundle="tools/bundle/VsaDefinition/Umpire.Vsa.Definition.csproj" />
    <_UmpireUnitPart Include="Web" Kind="Library" Source="framework/Kernel/Hosts/Web/Umpire.Hosts.Web.csproj" Bundle="tools/bundle/Web/Umpire.Web.csproj" />
    <_UmpireUnitPart Include="Web" Kind="Library" Source="packs/Vsa/Kernel/Views/Umpire.Vsa.Views.csproj" Bundle="tools/bundle/Web/Umpire.Web.csproj" />
    <_UmpireUnitPart Include="Console" Kind="Library" Source="framework/Kernel/Hosts/Console/Umpire.Hosts.Console.csproj" Bundle="tools/bundle/Console/Umpire.Console.csproj" />
    <_UmpireUnitPart Include="Definition" Kind="Library" Source="framework/Kernel/Definition/Umpire.Kernels.Definition.csproj" Bundle="tools/bundle/Definition/Umpire.Definition.csproj" />
    <_UmpireUnitPart Include="VsaDefinition" Kind="Library" Source="packs/Vsa/Definition/Umpire.Vsa.csproj" Bundle="tools/bundle/VsaDefinition/Umpire.Vsa.Definition.csproj" />
    <_UmpireUnitPart Include="Testing" Kind="Library" Source="packs/Vsa/Tests/Unit/Umpire.Vsa.Testing.Unit.csproj" Bundle="tools/bundle/Testing/Umpire.Testing.csproj" />
  </ItemGroup>

  <!-- The packages of the project, then their units, then the parts of these units. An Exclude and a Remove compare the
       names, so no condition reads item metadata outside a target. -->
  <ItemGroup>
    <_UmpireUnreferencedPackage Include="@(_UmpirePackageUnit)" Exclude="@(PackageReference)" />
    <_UmpireReferencedPackage Include="@(_UmpirePackageUnit)" />
    <_UmpireReferencedPackage Remove="@(_UmpireUnreferencedPackage)" />
    <PackageReference Remove="@(_UmpireReferencedPackage)" />
    <_UmpireUsedUnit Include="@(_UmpireReferencedPackage->'%(Unit)')" />
    <_UmpireUnusedPart Include="@(_UmpireUnitPart)" Exclude="@(_UmpireUsedUnit)" />
    <_UmpireUsedPart Include="@(_UmpireUnitPart)" />
    <_UmpireUsedPart Remove="@(_UmpireUnusedPart)" />
  </ItemGroup>
  <ItemGroup Condition="'$(_UmpireUseBundle)' != 'true'">
    <ProjectReference Include="@(_UmpireUsedPart->WithMetadataValue('Kind', 'Library')->'$(UmpireFrameworkSourceDir)%(Source)'->Distinct())" />
  </ItemGroup>
  <ItemGroup Condition="'$(_UmpireUseBundle)' == 'true'">
    <ProjectReference Include="@(_UmpireUsedPart->WithMetadataValue('Kind', 'Library')->'$(UmpireFrameworkSourceDir)%(Bundle)'->Distinct())" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="@(_UmpireUsedPart->WithMetadataValue('Kind', 'Analyzer')->'$(UmpireFrameworkSourceDir)%(Source)'->Distinct())"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- The definition of a pack is check-time code (Umpire.After.targets). Source mode builds its project first, with no
       reference to its assembly. A project with its own reference to that project keeps it. -->
  <ItemGroup Condition="'$(UmpireDefinitionProject)' != 'true' and '$(UmpireTestProject)' != 'true'">
    <_UmpirePackDefinitionPart Include="@(_UmpireUsedPart->WithMetadataValue('Kind', 'PackDefinition'))" />
    <_UmpirePackDefinition Include="@(_UmpirePackDefinitionPart->'%(PackName)')" />
    <_UmpirePackDefinitionProject Include="@(_UmpirePackDefinitionPart->'$(UmpireFrameworkSourceDir)%(Source)')" Condition="'$(_UmpireUseBundle)' != 'true'" />
    <_UmpirePackDefinitionProject Include="@(_UmpirePackDefinitionPart->'$(UmpireFrameworkSourceDir)%(Bundle)')" Condition="'$(_UmpireUseBundle)' == 'true'" />
    <_UmpirePackDefinitionProject Remove="@(ProjectReference)" />
    <ProjectReference Include="@(_UmpirePackDefinitionProject->Distinct())" ReferenceOutputAssembly="false" Private="false"
                      OutputItemType="_UmpirePackDefinitionOutput" SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained;OutputPath;OutDir;_CommandLineDefinedOutputPath" />
  </ItemGroup>

  <!-- Source mode gives the kernel analyzer from the folder of the pack analyzer, as the package of the pack does (pinned choice W24).
       Roslyn finds a dependency of an analyzer in the folder of that analyzer only if that file is an analyzer item. Else the
       compiler server takes the first registered path with the same name and version, in text order, and does not check that
       the file exists. Then a deleted test workspace or another worktree can win, and the pack rules do not load (CS8032).
       The target changes only the analyzer items of the Umpire analyzer projects of this file. It uses
       a copy only if it is the one copy and it exists, so a design-time build with no output keeps the kernel analyzer from its own folder. -->
  <Target Name="_UmpireKernelAnalyzerBesidePackAnalyzer" AfterTargets="ResolveProjectReferences">
    <PropertyGroup>
      <_UmpireKernelAnalyzerProject>$([MSBuild]::NormalizePath('$(UmpireFrameworkSourceDir)', 'framework', 'Kernel', 'Analyzers', 'Umpire.Kernels.Analyzers.csproj'))</_UmpireKernelAnalyzerProject>
    </PropertyGroup>
    <ItemGroup>
      <_UmpireAnalyzerProject Include="@(_UmpireUsedPart->WithMetadataValue('Kind', 'Analyzer')->'$(UmpireFrameworkSourceDir)%(Source)')" />
      <_UmpireAnalyzerProject Remove="$(_UmpireKernelAnalyzerProject)" />
      <_UmpireOwnKernelAnalyzer Include="@(Analyzer)" Condition="'%(Analyzer.MSBuildSourceProjectFile)' == '$(_UmpireKernelAnalyzerProject)'" />
      <_UmpireAnalyzerOfProject Include="%(Analyzer.MSBuildSourceProjectFile)" Analyzer="%(Analyzer.FullPath)" Condition="'%(Analyzer.MSBuildSourceProjectFile)' != ''" />
      <_UmpireAnalyzerOfOtherProject Include="@(_UmpireAnalyzerOfProject)" Exclude="@(_UmpireAnalyzerProject)" />
      <_UmpireAnalyzerOfProject Remove="@(_UmpireAnalyzerOfOtherProject)" />
      <_UmpireKernelAnalyzerOfPack Include="@(_UmpireAnalyzerOfProject->'%(Analyzer)'->'%(RootDir)%(Directory)Umpire.Kernels.Analyzers.dll'->Distinct())" />
      <_UmpireKernelAnalyzerOfPack Remove="@(_UmpireKernelAnalyzerOfPack)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <ItemGroup Condition="'@(_UmpireOwnKernelAnalyzer->Count())' == '1' and '@(_UmpireKernelAnalyzerOfPack->Count())' == '1'">
      <Analyzer Remove="@(_UmpireOwnKernelAnalyzer)" />
      <Analyzer Include="@(_UmpireKernelAnalyzerOfPack)" />
    </ItemGroup>
  </Target>
</Project>
