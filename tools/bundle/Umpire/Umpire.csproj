<Project Sdk="Microsoft.NET.Sdk">
  <!-- Umpire.dll: the core of the runtime: the markers, the config reader, the kernel and the messages. It holds no pack:
       the package Umpire.Vsa holds the VSA kernel. It holds no definition code: the packages Umpire.Definition and
       Umpire.Vsa.Definition hold it. -->
  <PropertyGroup>
    <Description>The Umpire runtime core: the kernel and the messages.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UmpireRoot)architecture/Markers/**/*.cs" Exclude="$(_UmpireNotBundled)" />
    <Compile Include="$(UmpireRoot)framework/Components/Config/**/*.cs" Exclude="$(_UmpireNotBundled)" />
    <Compile Include="$(UmpireRoot)framework/Components/Messages/**/*.cs" Exclude="$(_UmpireNotBundled)" />
    <Compile Include="$(UmpireRoot)framework/Kernel/**/*.cs"
             Exclude="$(_UmpireNotBundled);$(UmpireRoot)framework/Kernel/Definition/**;$(UmpireRoot)framework/Kernel/Hosts/Web/**;$(UmpireRoot)framework/Kernel/Hosts/Console/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Reflection.Metadata" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Umpire.Vsa" />
    <InternalsVisibleTo Include="Umpire.Web" />
    <InternalsVisibleTo Include="Umpire.Console" />
  </ItemGroup>
  <!-- The build files of each project that gets the package: Umpire.props, Umpire.After.targets (the source folders, the
       definitions, the rule values, the polyfills and the architecture check) and Umpire.targets (empty: NuGet needs a targets
       file with the name of the package). They are also in buildTransitive/, so a project that gets Umpire through another
       Umpire package gets them too. -->
  <ItemGroup>
    <None Remove="build/**" />
    <None Include="build/*" Pack="true" PackagePath="build;buildTransitive" />
    <None Include="build/Polyfills~/*" Pack="true" PackagePath="build/Polyfills~;buildTransitive/Polyfills~" />
  </ItemGroup>
  <!-- The package depends on the package Umpire.Engine, which holds the analyzer entry of the engine (all Umpire rules about
       code, with their values from .umpireconfig), so each project that references an Umpire package gets the analyzer. The
       reference is only for the pack: a build does not copy the engine files, and source mode adds the analyzer in
       Umpire.SourceMode.targets. -->
  <ItemGroup Condition="'$(_IsPacking)' == 'true'">
    <ProjectReference Include="../Engine/Umpire.Engine.csproj" Private="false" PrivateAssets="none" ExcludeAssets="compile" />
  </ItemGroup>
  <!-- NuGet takes the dependencies from the restore. A restore with no _IsPacking (dotnet pack with its no-restore switch)
       has no engine reference, so the package would have no analyzer. -->
  <Target Name="_UmpireCheckAnalyzerDependency" BeforeTargets="GenerateNuspec">
    <Error Condition="!$([System.IO.File]::ReadAllText('$(ProjectAssetsFile)').Contains('Umpire.Engine'))"
           Text="The restore of Umpire has no reference to Umpire.Engine, so the package would have no analyzer. Run dotnet pack with its own restore, or restore with -p:_IsPacking=true first." />
  </Target>
</Project>
