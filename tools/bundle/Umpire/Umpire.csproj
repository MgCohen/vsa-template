<Project Sdk="Microsoft.NET.Sdk">
  <!-- Umpire.dll: the definition API, the markers, the config reader, the kernel, the messages and the VSA pack with its layer bases.
       An app gets the Umpire runtime from this one package. -->
  <PropertyGroup>
    <Description>The Umpire runtime: the architecture definition API, the kernel, the messages and the VSA pack.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UmpireRoot)architecture/**/*.cs" Exclude="$(_UmpireNotBundled)" />
    <Compile Include="$(UmpireRoot)framework/Components/Config/**/*.cs" Exclude="$(_UmpireNotBundled)" />
    <Compile Include="$(UmpireRoot)framework/Components/Messages/**/*.cs" Exclude="$(_UmpireNotBundled)" />
    <Compile Include="$(UmpireRoot)framework/Kernel/**/*.cs"
             Exclude="$(_UmpireNotBundled);$(UmpireRoot)framework/Kernel/Analyzers/**;$(UmpireRoot)framework/Kernel/Hosts/Web/**;$(UmpireRoot)framework/Kernel/Hosts/Console/**" />
    <Compile Include="$(UmpireRoot)packs/Vsa/Kernel/**/*.cs" Exclude="$(_UmpireNotBundled);$(UmpireRoot)packs/Vsa/Kernel/Views/**" />
    <Compile Include="$(UmpireRoot)packs/Vsa/Definition/**/*.cs;$(UmpireRoot)packs/Vsa/VsaPack.cs" Exclude="$(_UmpireNotBundled)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Tomlyn" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Reflection.Metadata" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Umpire.Web" />
    <InternalsVisibleTo Include="Umpire.Console" />
  </ItemGroup>
  <!-- The package depends on the VSA analyzers and their rule values, so each app that references it gets them. The analyzers
       run only in a compilation that selects the VSA pack (RuleAnalyzer.PackNamespace). The reference is only for the pack:
       a build does not copy the analyzer DLL, and source mode adds the analyzers in Umpire.Sdk.Core.targets. -->
  <ItemGroup Condition="'$(_IsPacking)' == 'true'">
    <ProjectReference Include="$(UmpireRoot)packs/Vsa/Tests/Analyzers/Umpire.Vsa.Analyzers.csproj" Private="false" PrivateAssets="none" ExcludeAssets="compile" />
  </ItemGroup>
  <!-- NuGet takes the dependencies from the restore. A restore with no _IsPacking (dotnet pack with its no-restore switch)
       has no analyzer reference, so the package would have no analyzers. -->
  <Target Name="_UmpireCheckAnalyzerDependency" BeforeTargets="GenerateNuspec">
    <Error Condition="!$([System.IO.File]::ReadAllText('$(ProjectAssetsFile)').Contains('Umpire.Vsa.Analyzers'))"
           Text="The restore of Umpire has no reference to Umpire.Vsa.Analyzers, so the package would have no analyzers. Run dotnet pack with its own restore, or restore with -p:_IsPacking=true first." />
  </Target>
</Project>
