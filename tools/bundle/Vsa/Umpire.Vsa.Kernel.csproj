<Project Sdk="Microsoft.NET.Sdk">
  <!-- Umpire.Vsa.dll: the VSA kernel with its layer bases, VsaKernel, Plugin and the composition. An app with the VSA pack
       references it, directly or through Umpire.Web. The views are in Umpire.Web. It holds no definition code: the package
       Umpire.Vsa.Definition holds it. The source project of the VSA definition has the name Umpire.Vsa, and a solution
       cannot hold two projects with one name, so this project has the name Umpire.Vsa.Kernel. -->
  <PropertyGroup>
    <AssemblyName>Umpire.Vsa</AssemblyName>
    <PackageId>Umpire.Vsa</PackageId>
    <Description>The Umpire VSA kernel: VsaKernel and the VSA layer bases.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UmpireRoot)packs/Vsa/Kernel/**/*.cs" Exclude="$(_UmpireNotBundled);$(UmpireRoot)packs/Vsa/Kernel/Views/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Umpire/Umpire.csproj" PrivateAssets="none" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="build/**" />
    <None Include="build/*" Pack="true" PackagePath="build;buildTransitive" />
  </ItemGroup>
</Project>
