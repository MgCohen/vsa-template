<Project Sdk="Microsoft.NET.Sdk">
  <!-- Umpire.Testing.dll: the unit test base and the base of the tests of a VSA definition. A test project references it.
       The definition test base needs the definition packages, so the package depends on them. -->
  <PropertyGroup>
    <Description>The Umpire test bases: VsaUnitTest and VsaArchitectureTest.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UmpireRoot)packs/Vsa/Tests/Unit/**/*.cs" Exclude="$(_UmpireNotBundled)" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Vsa/Umpire.Vsa.Kernel.csproj" PrivateAssets="none" />
    <ProjectReference Include="../Definition/Umpire.Definition.csproj" PrivateAssets="none" />
    <ProjectReference Include="../VsaDefinition/Umpire.Vsa.Definition.csproj" PrivateAssets="none" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NUnit" />
  </ItemGroup>
</Project>
