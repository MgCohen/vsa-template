<Project Sdk="Microsoft.NET.Sdk">
  <!-- The one text file writer of the umpire tool: a new file is LF with no BOM, a changed file keeps its BOM and
       its dominant line ending. The tool bundles the DLL. It is a library with no pack, so it references only the package Umpire. -->
  <PropertyGroup>
    <UmpireFrameworkSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</UmpireFrameworkSourceDir>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../bundle/SourceMode/Umpire.SourceMode.props" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umpire" Version="$(UmpireVersion)" />
  </ItemGroup>
</Project>
