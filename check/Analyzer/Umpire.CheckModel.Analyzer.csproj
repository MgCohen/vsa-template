<Project Sdk="Microsoft.NET.Sdk">
  <!-- The analyzer of the check model: it makes the snapshot of its project from symbols and runs the operations on each type.
       RS1035: the analyzer saves the snapshot of its project at the end of a build. RS1030: the compiler driver keeps the semantic
       models, so a model from the compilation is the model of the driver. RS2008: the analyzer does not ship. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);RS1035;RS1030;RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../tools/sdk/Polyfills~/IsExternalInit.cs" LinkBase="Polyfills" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(UmpireAnalyzerRoslynVersion)" PrivateAssets="all" />
    <ProjectReference Include="../Model/Umpire.CheckModel.csproj" />
    <ProjectReference Include="../../framework/Kernel/Analyzers/Umpire.Kernels.Analyzers.csproj" />
  </ItemGroup>
</Project>
